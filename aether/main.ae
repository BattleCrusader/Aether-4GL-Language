// main.ae -- Aether compiler entry point
// Written in Aether v1
//
// The Go bootstrap compiler compiles this file into a native binary.
// This binary is the Aether compiler -- it reads .ae source files,
// tokenizes, parses, semantically analyzes, and generates x86_64 code,
// then writes an ELF64 binary.

import "tokenizer.ae"
import "lexer.ae"
import "parser.ae"
import "semantic.ae"
import "codegen.ae"

// __ae_read_file is a runtime helper provided by the Go bootstrap
// It reads a file and returns its contents as a string
// Returns empty string on error
@extern
func __ae_read_file(path: string): string;

// __ae_write_file is a runtime helper provided by the Go bootstrap
// It writes bytes to a file and returns 0 on success
@extern
func __ae_write_file(path: string, data: [byte], len: u64): u64;

// __ae_exit is a runtime helper provided by the Go bootstrap
// It exits the process with the given exit code
@extern
func __ae_exit(code: u64);

// __ae_get_arg is a runtime helper provided by the Go bootstrap
// It returns the i-th command-line argument (0-indexed, 0=program name)
// Returns empty string if i >= argc
@extern
func __ae_get_arg(i: u64): string;

// __ae_argc is a runtime helper provided by the Go bootstrap
// It returns the number of command-line arguments
@extern
func __ae_argc(): u64;

// __ae_print is a runtime helper provided by the Go bootstrap
// It prints a string to stdout
@extern
func __ae_print(s: string);

// __ae_fork is a runtime helper provided by the Go bootstrap
// It calls fork() and returns child PID in parent, 0 in child, -1 on error
@extern
func __ae_fork(): i64;

// __ae_execve is a runtime helper provided by the Go bootstrap
// It calls execve(path, argv, envp). Never returns on success.
@extern
func __ae_execve(path: string, argv: [string], envp: [string]): i64;

// __ae_wait4 is a runtime helper provided by the Go bootstrap
// It calls wait4(pid, status, options, rusage) and returns child PID.
@extern
func __ae_wait4(pid: i64, status: [byte], options: u64, rusage: u64): i64;

// __ae_pipe is a runtime helper provided by the Go bootstrap
// It calls pipe(fds) and returns 0 on success, -1 on error.
@extern
func __ae_pipe(fds: [u64]): i64;

// __ae_system is a runtime helper provided by the Go bootstrap
// It runs a shell command via fork + execve("/bin/sh", ["sh","-c",cmd]) + wait4.
// Returns the child's exit status, or -1 on fork error.
@extern
func __ae_system(cmd: string): i64;

// Entry point for the Aether compiler
@entry
func main(): u64 {
    // Read CLI args
    let argc = __ae_argc()
    if argc < 2 {
        __ae_print("usage: aether <source.ae> [-o output]\n")
        __ae_exit(1)
        return 1
    }

    // Parse args: first non-flag is canonical source path; all non-flag args are concatenated.
    var sourcePath = ""
    var outputPath = ""
    var hasSource = false
    var i: u64 = 1
    while i < argc {
        let arg = __ae_get_arg(i)
        if arg == "-o" {
            i = i + 1
            if i < argc {
                outputPath = __ae_get_arg(i)
            } else {
                __ae_print("error: -o requires an argument\n")
                __ae_exit(1)
                return 1
            }
        } else {
            if not hasSource {
                sourcePath = arg
                hasSource = true
            }
        }
        i = i + 1
    }

    if not hasSource {
        __ae_print("error: no source file specified\n")
        __ae_exit(1)
        return 1
    }

    if outputPath == "" {
        // Derive output name from source
        outputPath = sourcePath
        // Find last '.' and strip extension
        var dotPos: u64 = 0
        var j: u64 = 0
        while j < #outputPath {
            if outputPath[j] == 46 {  // '.'
                dotPos = j
            }
            j = j + 1
        }
        if dotPos > 0 {
            outputPath = outputPath[0:dotPos]
        }
    }

    // Read and concatenate all source files
    var source = ""
    var k: u64 = 1
    var seenFirst = false
    while k < argc {
        let arg = __ae_get_arg(k)
        if arg == "-o" {
            k = k + 2
        } else {
            if not seenFirst {
                seenFirst = true
                k = k + 1
            } else {
                let content = __ae_read_file(arg)
                if content == "" {
                    __ae_print("error: could not read source file: ")
                    __ae_print(arg)
                    __ae_print("\n")
                    __ae_exit(1)
                    return 1
                }
                source = source + content + "\n"
                k = k + 1
            }
        }
    }

    // If only one source file, read it directly (avoids concat overhead)
    if source == "" {
        source = __ae_read_file(sourcePath)
        if source == "" {
            __ae_print("error: could not read source file: ")
            __ae_print(sourcePath)
            __ae_print("\n")
            __ae_exit(1)
            return 1
        }
    } else {
        // Prepend first file content to the concatenated rest
        let firstContent = __ae_read_file(sourcePath)
        if firstContent == "" {
            __ae_print("error: could not read source file: ")
            __ae_print(sourcePath)
            __ae_print("\n")
            __ae_exit(1)
            return 1
        }
        source = firstContent + "\n" + source
    }

    // Phase 1: Tokenization
    var lexer = newLexer(source)
    lexer = tokenize(lexer)
    if lexer.hadError {
        __ae_print("error: tokenization failed: ")
        __ae_print(lexer.errorMsg)
        __ae_print("\n")
        __ae_exit(1)
        return 1
    }

    // Phase 2: Parsing
    var parser = newParser(lexer.tokens)
    parser = parse(parser)
    if #parser.errors > 0 {
        for k in 0..#parser.errors {
            __ae_print("error: ")
            __ae_print(parser.errors[k])
            __ae_print("\n")
        }
        __ae_exit(1)
        return 1
    }

    // Phase 3: Semantic Analysis
    var sem = newSemanticAnalyzer()
    sem = analyze(sem, parser.tokens)
    if #sem.errors > 0 {
        for k in 0..#sem.errors {
            __ae_print("warning: ")
            __ae_print(sem.errors[k])
            __ae_print("\n")
        }
    }

    // Phase 4: Code Generation
    var cg = newCodegen()
    cg = generate(cg, lexer.tokens)
    if #cg.errors > 0 {
        for k in 0..#cg.errors {
            __ae_print("error: ")
            __ae_print(cg.errors[k])
            __ae_print("\n")
        }
        __ae_exit(1)
        return 1
    }

    // Phase 5: Link -- write Mach-O binary directly (no system as/ld required).
    // Phase 4 future: this drops the `as`+`ld` workaround that the Go bootstrap uses.
    cg = linkMachO(cg)
    if #cg.errors > 0 {
        for k in 0..#cg.errors {
            __ae_print("error: ")
            __ae_print(cg.errors[k])
            __ae_print("\n")
        }
        __ae_exit(1)
        return 1
    }

    // Write output binary
    let result = __ae_write_file(outputPath, cg.output, #cg.output)
    if result != 0 {
        __ae_print("error: could not write output file: ")
        __ae_print(outputPath)
        __ae_print("\n")
        __ae_exit(1)
        return 1
    }

    __ae_print("Compiled ")
    __ae_print(sourcePath)
    __ae_print(" -> ")
    __ae_print(outputPath)
    __ae_print("\n")

    return 0
}

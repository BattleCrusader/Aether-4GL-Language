// lexer.ae — Lexer for the Aether compiler
// Tokenizes Aether source into a stream of tokens
// Written in Aether v1

import "tokenizer.ae"

struct Lexer {
    source: string,
    start: u64,
    current: u64,
    line: u64,
    column: u64,
    tokens: [Token],
    hadError: bool,
    errorMsg: string,
}

func newLexer(source: string): Lexer {
    var l: Lexer
    l.source = source
    l.start = 0
    l.current = 0
    l.line = 1
    l.column = 1
    l.tokens = []
    l.hadError = false
    l.errorMsg = ""
    return l
}

func lexerIsAtEnd(l: Lexer): bool {
    return l.current >= #l.source
}

func lexerAdvance(l: Lexer): Lexer {
    l.current = l.current + 1
    l.column = l.column + 1
    return l
}

func lexerPeek(l: Lexer): byte {
    if lexerIsAtEnd(l) {
        return 0
    }
    return l.source[l.current]
}

func lexerPeekNext(l: Lexer): byte {
    if l.current + 1 >= #l.source {
        return 0
    }
    return l.source[l.current + 1]
}

func lexerMatch(l: Lexer, expected: byte): Lexer {
    if lexerIsAtEnd(l) {
        return l
    }
    if l.source[l.current] != expected {
        return l
    }
    l.current = l.current + 1
    l.column = l.column + 1
    return l
}

func addToken(l: Lexer, typ: u64): Lexer {
    let lexeme = l.source[l.start:l.current]
    var tok: Token
    tok.typ = typ
    tok.lexeme = lexeme
    tok.line = l.line
    tok.column = l.column - (l.current - l.start)
    tok.literal = ""
    l.tokens = push(l.tokens, tok)
    return l
}

func addTokenLiteral(l: Lexer, typ: u64, literal: string): Lexer {
    let lexeme = l.source[l.start:l.current]
    var tok: Token
    tok.typ = typ
    tok.lexeme = lexeme
    tok.line = l.line
    tok.column = l.column - (l.current - l.start)
    tok.literal = literal
    l.tokens = push(l.tokens, tok)
    return l
}

func isDigit(c: byte): bool {
    return c >= 48 and c <= 57  // '0' to '9'
}

func isAlpha(c: byte): bool {
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95  // A-Z, a-z, _
}

func isAlphaNumeric(c: byte): bool {
    return isAlpha(c) or isDigit(c)
}

func string(l: Lexer): Lexer {
    while lexerPeek(l) != 34 and not lexerIsAtEnd(l) {  // 34 = '"'
        if lexerPeek(l) == 10 {  // '\n'
            l.line = l.line + 1
            l.column = 0
        }
        if lexerPeek(l) == 92 and lexerPeekNext(l) == 34 {  // backslash + quote
            l = lexerAdvance(l)
            l = lexerAdvance(l)
        } else if lexerPeek(l) == 92 and lexerPeekNext(l) == 123 {  // backslash + {
            l = lexerAdvance(l)
            l = lexerAdvance(l)
        } else {
            l = lexerAdvance(l)
        }
    }
    if lexerIsAtEnd(l) {
        l.hadError = true
        l.errorMsg = "unterminated string"
        return l
    }
    l = lexerAdvance(l)  // closing quote
    let lexeme = l.source[l.start:l.current]
    l = addTokenLiteral(l, TOKEN_STRING, lexeme[1:#lexeme-1])
    return l
}

func char(l: Lexer): Lexer {
    if lexerPeek(l) == 92 {  // backslash
        l = lexerAdvance(l)
        l = lexerAdvance(l)
    } else {
        l = lexerAdvance(l)
    }
    if lexerPeek(l) != 39 {  // '
        l.hadError = true
        l.errorMsg = "unterminated char literal"
        return l
    }
    l = lexerAdvance(l)
    let lexeme = l.source[l.start:l.current]
    l = addTokenLiteral(l, TOKEN_CHAR, lexeme)
    return l
}

func number(l: Lexer): Lexer {
    while isDigit(lexerPeek(l)) {
        l = lexerAdvance(l)
    }
    if lexerPeek(l) == 46 and lexerPeekNext(l) != 46 and isDigit(lexerPeekNext(l)) {  // '.' but not '..'
        l = lexerAdvance(l)
        while isDigit(lexerPeek(l)) {
            l = lexerAdvance(l)
        }
        if lexerPeek(l) == 101 or lexerPeek(l) == 69 {  // 'e' or 'E'
            l = lexerAdvance(l)
            if lexerPeek(l) == 43 or lexerPeek(l) == 45 {  // '+' or '-'
                l = lexerAdvance(l)
            }
            while isDigit(lexerPeek(l)) {
                l = lexerAdvance(l)
            }
        }
        let lexeme = l.source[l.start:l.current]
        l = addTokenLiteral(l, TOKEN_FLOAT, lexeme)
    } else {
        let lexeme = l.source[l.start:l.current]
        l = addTokenLiteral(l, TOKEN_INTEGER, lexeme)
    }
    return l
}

func identifier(l: Lexer): Lexer {
    while isAlphaNumeric(lexerPeek(l)) {
        l = lexerAdvance(l)
    }
    let lexeme = l.source[l.start:l.current]
    // Keyword lookup via static chain (global arrays are not yet emitted
    // by the bootstrap; a chain keeps the self-hosted compiler correct).
    if lexeme == "and"
        return addToken(l, TOKEN_KW_AND)
    if lexeme == "as"
        return addToken(l, TOKEN_KW_AS)
    if lexeme == "bool"
        return addToken(l, TOKEN_KW_BOOL)
    if lexeme == "break"
        return addToken(l, TOKEN_KW_BREAK)
    if lexeme == "byte"
        return addToken(l, TOKEN_KW_BYTE)
    if lexeme == "catch"
        return addToken(l, TOKEN_KW_CATCH)
    if lexeme == "char"
        return addToken(l, TOKEN_KW_CHAR)
    if lexeme == "class"
        return addToken(l, TOKEN_KW_CLASS)
    if lexeme == "const"
        return addToken(l, TOKEN_KW_CONST)
    if lexeme == "continue"
        return addToken(l, TOKEN_KW_CONTINUE)
    if lexeme == "copy"
        return addToken(l, TOKEN_KW_COPY)
    if lexeme == "defer"
        return addToken(l, TOKEN_KW_DEFER)
    if lexeme == "double"
        return addToken(l, TOKEN_KW_DOUBLE)
    if lexeme == "dyn"
        return addToken(l, TOKEN_KW_DYN)
    if lexeme == "elif"
        return addToken(l, TOKEN_KW_ELIF)
    if lexeme == "else"
        return addToken(l, TOKEN_KW_ELSE)
    if lexeme == "enum"
        return addToken(l, TOKEN_KW_ENUM)
    if lexeme == "export"
        return addToken(l, TOKEN_KW_EXPORT)
    if lexeme == "extern"
        return addToken(l, TOKEN_KW_EXTERN)
    if lexeme == "false"
        return addToken(l, TOKEN_KW_FALSE)
    if lexeme == "float"
        return addToken(l, TOKEN_KW_FLOAT)
    if lexeme == "for"
        return addToken(l, TOKEN_KW_FOR)
    if lexeme == "func"
        return addToken(l, TOKEN_KW_FUNC)
    if lexeme == "heap"
        return addToken(l, TOKEN_KW_HEAP)
    if lexeme == "i8"
        return addToken(l, TOKEN_KW_I8)
    if lexeme == "i16"
        return addToken(l, TOKEN_KW_I16)
    if lexeme == "i32"
        return addToken(l, TOKEN_KW_I32)
    if lexeme == "i64"
        return addToken(l, TOKEN_KW_I64)
    if lexeme == "if"
        return addToken(l, TOKEN_KW_IF)
    if lexeme == "impl"
        return addToken(l, TOKEN_KW_IMPL)
    if lexeme == "import"
        return addToken(l, TOKEN_KW_IMPORT)
    if lexeme == "in"
        return addToken(l, TOKEN_KW_IN)
    if lexeme == "init"
        return addToken(l, TOKEN_KW_INIT)
    if lexeme == "int"
        return addToken(l, TOKEN_KW_INT)
    if lexeme == "internal"
        return addToken(l, TOKEN_KW_INTERNAL)
    if lexeme == "let"
        return addToken(l, TOKEN_KW_LET)
    if lexeme == "module"
        return addToken(l, TOKEN_KW_MODULE)
    if lexeme == "none"
        return addToken(l, TOKEN_KW_NONE)
    if lexeme == "not"
        return addToken(l, TOKEN_KW_NOT)
    if lexeme == "or"
        return addToken(l, TOKEN_KW_OR)
    if lexeme == "pool"
        return addToken(l, TOKEN_KW_POOL)
    if lexeme == "post"
        return addToken(l, TOKEN_KW_POST)
    if lexeme == "pre"
        return addToken(l, TOKEN_KW_PRE)
    if lexeme == "private"
        return addToken(l, TOKEN_KW_PRIVATE)
    if lexeme == "protocol"
        return addToken(l, TOKEN_KW_PROTOCOL)
    if lexeme == "public"
        return addToken(l, TOKEN_KW_PUBLIC)
    if lexeme == "region"
        return addToken(l, TOKEN_KW_REGION)
    if lexeme == "return"
        return addToken(l, TOKEN_KW_RETURN)
    if lexeme == "self"
        return addToken(l, TOKEN_KW_SELF)
    if lexeme == "static"
        return addToken(l, TOKEN_KW_STATIC)
    if lexeme == "string"
        return addToken(l, TOKEN_KW_STRING)
    if lexeme == "struct"
        return addToken(l, TOKEN_KW_STRUCT)
    if lexeme == "super"
        return addToken(l, TOKEN_KW_SUPER)
    if lexeme == "sys"
        return addToken(l, TOKEN_KW_SYS)
    if lexeme == "throw"
        return addToken(l, TOKEN_KW_THROW)
    if lexeme == "trait"
        return addToken(l, TOKEN_KW_TRAIT)
    if lexeme == "true"
        return addToken(l, TOKEN_KW_TRUE)
    if lexeme == "try"
        return addToken(l, TOKEN_KW_TRY)
    if lexeme == "type"
        return addToken(l, TOKEN_KW_TYPE)
    if lexeme == "u8"
        return addToken(l, TOKEN_KW_U8)
    if lexeme == "u16"
        return addToken(l, TOKEN_KW_U16)
    if lexeme == "u32"
        return addToken(l, TOKEN_KW_U32)
    if lexeme == "u64"
        return addToken(l, TOKEN_KW_U64)
    if lexeme == "u128"
        return addToken(l, TOKEN_KW_U128)
    if lexeme == "unsafe"
        return addToken(l, TOKEN_KW_UNSAFE)
    if lexeme == "var"
        return addToken(l, TOKEN_KW_VAR)
    if lexeme == "void"
        return addToken(l, TOKEN_KW_VOID)
    if lexeme == "while"
        return addToken(l, TOKEN_KW_WHILE)
    if lexeme == "yield"
        return addToken(l, TOKEN_KW_YIELD)
    if lexeme == "match"
        return addToken(l, TOKEN_KW_MATCH)
    if lexeme == "case"
        return addToken(l, TOKEN_KW_CASE)
    return addToken(l, TOKEN_IDENT)
}

func scanToken(l: Lexer): Lexer {
    let al = lexerAdvance(l)
    let c = al.source[al.current - 1]
    l = al
    match c {
        case 40 -> l = addToken(l, TOKEN_LPAREN)  // (
        case 41 -> l = addToken(l, TOKEN_RPAREN)  // )
        case 123 -> l = addToken(l, TOKEN_LBRACE)  // {
        case 125 -> l = addToken(l, TOKEN_RBRACE)  // }
        case 91 -> l = addToken(l, TOKEN_LBRACKET)  // [
        case 93 -> l = addToken(l, TOKEN_RBRACKET)  // ]
        case 44 -> l = addToken(l, TOKEN_COMMA)  // ,
        case 59 -> l = addToken(l, TOKEN_SEMICOLON)  // ;
        case 58 -> {  // :
            if lexerMatch(l, 58).current > l.current {  // ::
                l = addToken(l, TOKEN_COLON_COLON)
            } else {
                l = addToken(l, TOKEN_COLON)
            }
        }
        case 63 -> l = addToken(l, TOKEN_QUESTION)  // ?
        case 64 -> l = addToken(l, TOKEN_AT)  // @
        case 35 -> l = addToken(l, TOKEN_HASH)  // #
        case 46 -> {  // .
            if lexerMatch(l, 46).current > l.current {  // ..
                if lexerMatch(l, 46).current > l.current {  // ...
                    l = addToken(l, TOKEN_DOT_DOT_DOT)
                } else if lexerMatch(l, 61).current > l.current {  // ..=
                    l = addToken(l, TOKEN_DOT_DOT_EQUAL)
                } else {
                    l = addToken(l, TOKEN_DOT_DOT)
                }
            } else {
                l = addToken(l, TOKEN_DOT)
            }
        }
        case 43 -> {  // +
            if lexerMatch(l, 43).current > l.current {  // ++
                l = addToken(l, TOKEN_PLUS_PLUS)
            } else if lexerMatch(l, 61).current > l.current {  // +=
                l = addToken(l, TOKEN_PLUS_EQUAL)
            } else {
                l = addToken(l, TOKEN_PLUS)
            }
        }
        case 45 -> {  // -
            if lexerMatch(l, 45).current > l.current {  // --
                l = addToken(l, TOKEN_MINUS_MINUS)
            } else if lexerMatch(l, 61).current > l.current {  // -=
                l = addToken(l, TOKEN_MINUS_EQUAL)
            } else if lexerMatch(l, 62).current > l.current {  // ->
                l = addToken(l, TOKEN_ARROW)
            } else {
                l = addToken(l, TOKEN_MINUS)
            }
        }
        case 42 -> {  // *
            if lexerMatch(l, 61).current > l.current {  // *=
                l = addToken(l, TOKEN_STAR_EQUAL)
            } else {
                l = addToken(l, TOKEN_STAR)
            }
        }
        case 47 -> {  // /
            if lexerMatch(l, 47).current > l.current {  // // comment
                while lexerPeek(l) != 10 and not lexerIsAtEnd(l) {
                    l = lexerAdvance(l)
                }
            } else if lexerMatch(l, 42).current > l.current {  // /* comment
                while not lexerIsAtEnd(l) {
                    if lexerPeek(l) == 42 and lexerPeekNext(l) == 47 {
                        l = lexerAdvance(l)
                        l = lexerAdvance(l)
                        break
                    }
                    if lexerPeek(l) == 10 {
                        l.line = l.line + 1
                        l.column = 0
                    }
                    l = lexerAdvance(l)
                }
            } else if lexerMatch(l, 61).current > l.current {  // /=
                l = addToken(l, TOKEN_SLASH_EQUAL)
            } else {
                l = addToken(l, TOKEN_SLASH)
            }
        }
        case 37 -> {  // %
            if lexerMatch(l, 61).current > l.current {  // %=
                l = addToken(l, TOKEN_PERCENT_EQUAL)
            } else {
                l = addToken(l, TOKEN_PERCENT)
            }
        }
        case 38 -> {  // &
            if lexerMatch(l, 38).current > l.current {  // &&
                l = addToken(l, TOKEN_AMPERSAND_AMPERSAND)
            } else if lexerMatch(l, 61).current > l.current {  // &=
                l = addToken(l, TOKEN_AMPERSAND_EQUAL)
            } else {
                l = addToken(l, TOKEN_AMPERSAND)
            }
        }
        case 124 -> {  // |
            if lexerMatch(l, 124).current > l.current {  // ||
                l = addToken(l, TOKEN_PIPE_PIPE)
            } else if lexerMatch(l, 61).current > l.current {  // |=
                l = addToken(l, TOKEN_PIPE_EQUAL)
            } else {
                l = addToken(l, TOKEN_PIPE)
            }
        }
        case 94 -> {  // ^
            if lexerMatch(l, 61).current > l.current {  // ^=
                l = addToken(l, TOKEN_CARET_EQUAL)
            } else {
                l = addToken(l, TOKEN_CARET)
            }
        }
        case 126 -> l = addToken(l, TOKEN_TILDE)  // ~
        case 33 -> {  // !
            if lexerMatch(l, 61).current > l.current {  // !=
                l = addToken(l, TOKEN_EXCLAIM_EQUAL)
            } else {
                l = addToken(l, TOKEN_EXCLAIM)
            }
        }
        case 60 -> {  // <
            if lexerMatch(l, 60).current > l.current {  // <<
                if lexerMatch(l, 61).current > l.current {  // <<=
                    l = addToken(l, TOKEN_LESS_LESS_EQUAL)
                } else {
                    l = addToken(l, TOKEN_LESS_LESS)
                }
            } else if lexerMatch(l, 61).current > l.current {  // <=
                l = addToken(l, TOKEN_LESS_EQUAL)
            } else {
                l = addToken(l, TOKEN_LESS)
            }
        }
        case 62 -> {  // >
            if lexerMatch(l, 62).current > l.current {  // >>
                if lexerMatch(l, 61).current > l.current {  // >>=
                    l = addToken(l, TOKEN_GREATER_GREATER_EQUAL)
                } else {
                    l = addToken(l, TOKEN_GREATER_GREATER)
                }
            } else if lexerMatch(l, 61).current > l.current {  // >=
                l = addToken(l, TOKEN_GREATER_EQUAL)
            } else {
                l = addToken(l, TOKEN_GREATER)
            }
        }
        case 61 -> {  // =
            if lexerMatch(l, 61).current > l.current {  // ==
                l = addToken(l, TOKEN_EQUAL_EQUAL)
            } else {
                l = addToken(l, TOKEN_EQUAL)
            }
        }
        case 32, 13, 9 -> {}  // space, CR, tab — skip
        case 10 -> {  // newline
            l.line = l.line + 1
            l.column = 1
        }
        case 34 -> l = string(l)  // "
        case 39 -> l = char(l)  // '
        else -> {
            if isDigit(c) {
                l = number(l)
            } else if isAlpha(c) {
                l = identifier(l)
            } else {
                l.hadError = true
                l.errorMsg = "unexpected character"
            }
        }
    }
    return l
}

func tokenize(l: Lexer): Lexer {
    while not lexerIsAtEnd(l) {
        l.start = l.current
        l = scanToken(l)
        if l.hadError {
            return l
        }
    }
    l = addToken(l, TOKEN_EOF)
    return l
}

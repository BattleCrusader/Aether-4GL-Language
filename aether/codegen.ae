// codegen.ae -- Native x86_64 code generator for Aether
// Written in Aether v1
//
// Generates x86_64 machine code from tokens/AST and produces an ELF64 binary.
// Mirrors the Go bootstrap's codegen.go implementation.

import "tokenizer.ae"
import "ast.ae"

// Register codes (matching x86_64 encoding)
let REG_RAX: u64 = 0
let REG_RCX: u64 = 1
let REG_RDX: u64 = 2
let REG_RBX: u64 = 3
let REG_RSP: u64 = 4
let REG_RBP: u64 = 5
let REG_RSI: u64 = 6
let REG_RDI: u64 = 7
let REG_R8: u64 = 8
let REG_R9: u64 = 9
let REG_R10: u64 = 10
let REG_R11: u64 = 11
let REG_R12: u64 = 12
let REG_R13: u64 = 13
let REG_R14: u64 = 14
let REG_R15: u64 = 15

// REX prefix
let REX_W: byte = 0x48

struct codegen {
    text: [byte],
    data: [byte],
    rodata: [byte],
    bss: [byte],
    labels: [string],
    labelOffsets: [u64],
    // Label reference tracking for linker patching
    labelRefs: [string],      // which label each placeholder references
    labelRefOffsets: [u64],   // offset in text where the placeholder is
    labelRefSizes: [u64],     // size of the placeholder (4 for u32 disp)
    strings: [string],        // string content for rodata
    stringLabels: [string],   // label names for strings
    errors: [string],
    output: [byte],           // final binary
    labelCount: u64,
    lastStringLabel: string,  // last string label name (set by addString)
    lastCallee: string,      // last function callee name (set by genPrimary)
    // Per-function state
    funcName: string,
    stackOffsets: [string],   // variable names
    stackOffsetVals: [u64],   // corresponding offsets
    stackSize: u64,
    // Variable type tracking (parallel to stackOffsets)
    varTypes: [string],
    // Struct tracking (name -> size in bytes, all fields 8 bytes)
    structNames: [string],
    structSizes: [u64],
    // Per-struct per-field info (parallel arrays, all fields 8 bytes)
    // structFields[name] is concatenated as "StructName.fieldName" for lookup.
    structFields: [string],
    structFieldOffsets: [u64],
}
func newCodegen(): codegen {
    var c: codegen
    c.text = []
    c.data = []
    c.rodata = []
    c.bss = []
    c.labels = []
    c.labelOffsets = []
    c.labelRefs = []
    c.labelRefOffsets = []
    c.labelRefSizes = []
    c.strings = []
    c.stringLabels = []
    c.errors = []
    c.output = []
    c.labelCount = 0
    c.funcName = ""
    c.stackOffsets = []
    c.stackOffsetVals = []
    c.lastStringLabel = ""
    c.lastCallee = ""
    c.varTypes = []
    c.structNames = []
    c.structSizes = []
    c.structFields = []
    c.structFieldOffsets = []
    return c
}

func codegenAddError(c: codegen, msg: string): codegen {
    c.errors = push(c.errors, msg)
    return c
}
// ============================================================
// Byte emission
// ============================================================

// emitByte: emit a single byte to the text buffer.
// b is a u64; we push the low 8 bits into the byte array.
func emitByte(c: codegen, b: u64): codegen {
    var lo: u64 = b & 0xFF
    c.text = push(c.text, lo)
    return c
}

func emitBytes(c: codegen, bytes: [byte]): codegen {
    for i in 0..#bytes {
        c.text = push(c.text, bytes[i])
    }
    return c
}

func emitU64(c: codegen, val: u64): codegen {
    c = emitByte(c, val & 0xFF)
    c = emitByte(c, (val >> 8) & 0xFF)
    c = emitByte(c, (val >> 16) & 0xFF)
    c = emitByte(c, (val >> 24) & 0xFF)
    c = emitByte(c, (val >> 32) & 0xFF)
    c = emitByte(c, (val >> 40) & 0xFF)
    c = emitByte(c, (val >> 48) & 0xFF)
    c = emitByte(c, (val >> 56) & 0xFF)
    return c
}

func emitU32(c: codegen, val: u64): codegen {
    c = emitByte(c, val & 0xFF)
    c = emitByte(c, (val >> 8) & 0xFF)
    c = emitByte(c, (val >> 16) & 0xFF)
    c = emitByte(c, (val >> 24) & 0xFF)
    return c
}

// ============================================================
// REX prefix
// ============================================================

func emitRexW(c: codegen): codegen {
    return emitByte(c, REX_W)
}

// emitRexWRB emits a REX.W prefix with optional REX.R (regField >= 8) and
// REX.B (rmField >= 8). Mirrors the Go bootstrap's emitRexWRB exactly so the
// Aether compiler emits byte-identical code.
func emitRexWRB(c: codegen, regField: byte, rmField: byte): codegen {
    var rex: byte = REX_W
    if regField >= 8 { rex = rex | 0x04 }  // REX.R
    if rmField >= 8 { rex = rex | 0x01 }   // REX.B
    return emitByte(c, rex)
}

// ============================================================
// ModRM byte
// ============================================================

func modRM(mod: byte, reg: byte, rm: byte): byte {
    return (mod << 6) | ((reg & 7) << 3) | (rm & 7)
}

// ============================================================
// Register code lookup
// ============================================================

func regCode(name: string): byte {
    if name == "rax"
        return 0
    if name == "rcx"
        return 1
    if name == "rdx"
        return 2
    if name == "rbx"
        return 3
    if name == "rsp"
        return 4
    if name == "rbp"
        return 5
    if name == "rsi"
        return 6
    if name == "rdi"
        return 7
    if name == "r8"
        return 8
    if name == "r9"
        return 9
    if name == "r10"
        return 10
    if name == "r11"
        return 11
    if name == "r12"
        return 12
    if name == "r13"
        return 13
    if name == "r14"
        return 14
    if name == "r15"
        return 15
    return 0
}

func needsRex(reg: string): bool {
    let code = regCode(reg)
    return code >= 8
}

// ============================================================
// mov rax, imm64
// ============================================================

func emitMovR64Imm64(c: codegen, reg: string, val: u64): codegen {
    c = emitRexWRB(c, 0, regCode(reg))
    c = emitByte(c, 0xB8 + (regCode(reg) & 7))
    c = emitU64(c, val)
    return c
}

// mov rax, rbx
func emitMovR64R64(c: codegen, dst: string, src: string): codegen {
    c = emitRexWRB(c, regCode(src), regCode(dst))
    c = emitByte(c, 0x89)
    // 0x89: MOV r/m64, r64 -- reg field = source, rm field = destination
    c = emitByte(c, modRM(3, regCode(src), regCode(dst)))
    return c
}

// lea rax, [label] -- RIP-relative (records label reference for linker)
func emitLeaR64Label(c: codegen, reg: string, labelName: string): codegen {
    c = emitRexWRB(c, regCode(reg), 5)
    c = emitByte(c, 0x8D)
    c = emitByte(c, modRM(0, regCode(reg), 5))  // RIP-relative
    // Record the label reference before emitting placeholder
    c.labelRefs = push(c.labelRefs, labelName)
    c.labelRefOffsets = push(c.labelRefOffsets, #c.text)
    c.labelRefSizes = push(c.labelRefSizes, 4)
    c = emitU32(c, 0)  // placeholder displacement
    return c
}

// ============================================================
// add/sub
// ============================================================

// add rax, rbx
func emitAddR64R64(c: codegen, dst: string, src: string): codegen {
    c = emitRexWRB(c, regCode(src), regCode(dst))
    c = emitByte(c, 0x01)
    // 0x01: ADD r/m64, r64 -- reg field = source, rm field = destination
    c = emitByte(c, modRM(3, regCode(src), regCode(dst)))
    return c
}

// add rax, imm8
func emitAddR64Imm8(c: codegen, reg: string, imm: byte): codegen {
    c = emitRexWRB(c, 0, regCode(reg))
    c = emitByte(c, 0x83)
    c = emitByte(c, modRM(3, 0, regCode(reg)))
    c = emitByte(c, imm)
    return c
}

// sub rax, rbx
func emitSubR64R64(c: codegen, dst: string, src: string): codegen {
    c = emitRexWRB(c, regCode(src), regCode(dst))
    c = emitByte(c, 0x29)
    // 0x29: SUB r/m64, r64 -- reg field = source, rm field = destination
    c = emitByte(c, modRM(3, regCode(src), regCode(dst)))
    return c
}

// sub rax, imm8
func emitSubR64Imm8(c: codegen, reg: string, imm: byte): codegen {
    c = emitRexWRB(c, 5, regCode(reg))
    c = emitByte(c, 0x83)
    c = emitByte(c, modRM(3, 5, regCode(reg)))
    c = emitByte(c, imm)
    return c
}

// ============================================================
// mul/div
// ============================================================

// mul rbx (rax = rax * rbx)
func emitMulR64(c: codegen, reg: string): codegen {
    c = emitRexW(c)
    c = emitByte(c, 0xF7)
    c = emitByte(c, modRM(3, 4, regCode(reg)))
    return c
}

// div rbx (rax = rax / rbx, rdx = rax % rbx)
func emitDivR64(c: codegen, reg: string): codegen {
    // xor rdx, rdx first
    c = emitXorR64R64(c, "rdx", "rdx")
    c = emitRexW(c)
    c = emitByte(c, 0xF7)
    c = emitByte(c, modRM(3, 6, regCode(reg)))
    return c
}

// ============================================================
// xor/neg/not
// ============================================================

// xor rax, rbx
func emitXorR64R64(c: codegen, dst: string, src: string): codegen {
    c = emitRexWRB(c, regCode(src), regCode(dst))
    c = emitByte(c, 0x31)
    c = emitByte(c, modRM(3, regCode(src), regCode(dst)))
    return c
}

// neg rax
func emitNegR64(c: codegen, reg: string): codegen {
    c = emitRexW(c)
    c = emitByte(c, 0xF7)
    c = emitByte(c, modRM(3, 3, regCode(reg)))
    return c
}

// not rax
func emitNotR64(c: codegen, reg: string): codegen {
    c = emitRexW(c)
    c = emitByte(c, 0xF7)
    c = emitByte(c, modRM(3, 2, regCode(reg)))
    return c
}

// ============================================================
// test/cmp
// ============================================================

// test rax, rax
func emitTestR64R64(c: codegen, dst: string, src: string): codegen {
    c = emitRexWRB(c, regCode(src), regCode(dst))
    c = emitByte(c, 0x85)
    c = emitByte(c, modRM(3, regCode(src), regCode(dst)))
    return c
}

// cmp rax, rbx
func emitCmpR64R64(c: codegen, dst: string, src: string): codegen {
    c = emitRexWRB(c, regCode(src), regCode(dst))
    c = emitByte(c, 0x39)
    // 0x39: CMP r/m64, r64 -- computes r/m64 - r64
    // reg field = r64 (source), rm field = r/m64 (destination)
    // modRM(3, regCode(src), regCode(dst)) gives "cmp dst, src" = dst - src
    c = emitByte(c, modRM(3, regCode(src), regCode(dst)))
    return c
}

// ============================================================
// and/or/shift
// ============================================================

// and rax, rbx
func emitAndR64R64(c: codegen, dst: string, src: string): codegen {
    c = emitRexW(c)
    c = emitByte(c, 0x21)
    c = emitByte(c, modRM(3, regCode(dst), regCode(src)))
    return c
}

// or rax, rbx
func emitOrR64R64(c: codegen, dst: string, src: string): codegen {
    c = emitRexW(c)
    c = emitByte(c, 0x09)
    c = emitByte(c, modRM(3, regCode(dst), regCode(src)))
    return c
}

// shl rax, cl
func emitShlR64(c: codegen, reg: string): codegen {
    c = emitRexW(c)
    c = emitByte(c, 0xD3)
    c = emitByte(c, modRM(3, 4, regCode(reg)))
    return c
}

// shr rax, cl
func emitShrR64(c: codegen, reg: string): codegen {
    c = emitRexW(c)
    c = emitByte(c, 0xD3)
    c = emitByte(c, modRM(3, 5, regCode(reg)))
    return c
}

// ============================================================
// setcc instructions
// ============================================================

// sete al
func emitSete(c: codegen, reg: string): codegen {
    c = emitByte(c, 0x0F)
    c = emitByte(c, 0x94)
    c = emitByte(c, modRM(3, 0, regCode(reg)))
    return c
}

// setne al
func emitSetne(c: codegen, reg: string): codegen {
    c = emitByte(c, 0x0F)
    c = emitByte(c, 0x95)
    c = emitByte(c, modRM(3, 0, regCode(reg)))
    return c
}

// setl al
func emitSetl(c: codegen, reg: string): codegen {
    c = emitByte(c, 0x0F)
    c = emitByte(c, 0x9C)
    c = emitByte(c, modRM(3, 0, regCode(reg)))
    return c
}

// setg al
func emitSetg(c: codegen, reg: string): codegen {
    c = emitByte(c, 0x0F)
    c = emitByte(c, 0x9F)
    c = emitByte(c, modRM(3, 0, regCode(reg)))
    return c
}

// setle al
func emitSetle(c: codegen, reg: string): codegen {
    c = emitByte(c, 0x0F)
    c = emitByte(c, 0x9E)
    c = emitByte(c, modRM(3, 0, regCode(reg)))
    return c
}

// setge al
func emitSetge(c: codegen, reg: string): codegen {
    c = emitByte(c, 0x0F)
    c = emitByte(c, 0x9D)
    c = emitByte(c, modRM(3, 0, regCode(reg)))
    return c
}

// movzx rax, al
func emitMovzxR64R8(c: codegen, dst: string, src: string): codegen {
    c = emitRexW(c)
    c = emitByte(c, 0x0F)
    c = emitByte(c, 0xB6)
    c = emitByte(c, modRM(3, regCode(dst), regCode(src)))
    return c
}

// ============================================================
// push/pop
// ============================================================

// push rax
func emitPush(c: codegen, reg: string): codegen {
    let code = regCode(reg)
    if code < 8 {
        c = emitByte(c, 0x50 + code)
    } else {
        c = emitByte(c, 0x41)
        c = emitByte(c, 0x50 + (code - 8))
    }
    return c
}

// pop rax
func emitPop(c: codegen, reg: string): codegen {
    let code = regCode(reg)
    if code < 8 {
        c = emitByte(c, 0x58 + code)
    } else {
        c = emitByte(c, 0x41)
        c = emitByte(c, 0x58 + (code - 8))
    }
    return c
}

// ============================================================
// call/jmp/jcc (with label reference tracking)
// ============================================================

// call label (relative, records label reference for linker)
func emitCallLabel(c: codegen, labelName: string): codegen {
    c = emitByte(c, 0xE8)
    c.labelRefs = push(c.labelRefs, labelName)
    c.labelRefOffsets = push(c.labelRefOffsets, #c.text)
    c.labelRefSizes = push(c.labelRefSizes, 4)
    c = emitU32(c, 0)  // placeholder, patched by linker
    return c
}

// jmp label (relative, records label reference for linker)
func emitJmpLabel(c: codegen, labelName: string): codegen {
    c = emitByte(c, 0xE9)
    c.labelRefs = push(c.labelRefs, labelName)
    c.labelRefOffsets = push(c.labelRefOffsets, #c.text)
    c.labelRefSizes = push(c.labelRefSizes, 4)
    c = emitU32(c, 0)  // placeholder, patched by linker
    return c
}

// jz label (jump if zero, relative, records label reference for linker)
func emitJzLabel(c: codegen, labelName: string): codegen {
    c = emitByte(c, 0x0F)
    c = emitByte(c, 0x84)
    c.labelRefs = push(c.labelRefs, labelName)
    c.labelRefOffsets = push(c.labelRefOffsets, #c.text)
    c.labelRefSizes = push(c.labelRefSizes, 4)
    c = emitU32(c, 0)  // placeholder, patched by linker
    return c
}

// jnz label (jump if not zero, relative, records label reference for linker)
func emitJnzLabel(c: codegen, labelName: string): codegen {
    c = emitByte(c, 0x0F)
    c = emitByte(c, 0x85)
    c.labelRefs = push(c.labelRefs, labelName)
    c.labelRefOffsets = push(c.labelRefOffsets, #c.text)
    c.labelRefSizes = push(c.labelRefSizes, 4)
    c = emitU32(c, 0)  // placeholder, patched by linker
    return c
}

// ============================================================
// ret/syscall
// ============================================================

func emitRet(c: codegen): codegen {
    return emitByte(c, 0xC3)
}

func emitSyscall(c: codegen): codegen {
    c = emitByte(c, 0x0F)
    c = emitByte(c, 0x05)
    return c
}

// ============================================================
// Stack frame helpers
// ============================================================

// mov rax, [rbp - offset]
func emitMovStackR64(c: codegen, reg: string, offset: u64): codegen {
    if offset > 127 {
        // disp32 form: REX.W + 8B + modrm(10, reg, rbp) + disp32 (negative)
        c = emitRexWRB(c, regCode(reg), 5)
        c = emitByte(c, 0x8B)
        c = emitByte(c, modRM(2, regCode(reg), 5))  // [rbp + disp32]
        c = emitU32(c, 0 - offset)
        return c
    }
    c = emitRexW(c)
    c = emitByte(c, 0x8B)
    c = emitByte(c, modRM(1, regCode(reg), 5))  // [rbp + disp8]
    c = emitByte(c, 0 - offset)  // negative offset from rbp
    return c
}

// mov [rbp - offset], rax
func emitMovR64Stack(c: codegen, reg: string, offset: u64): codegen {
    if offset > 127 {
        // disp32 form: REX.W + 89 + modrm(10, reg, rbp) + disp32 (negative)
        c = emitRexWRB(c, regCode(reg), 5)
        c = emitByte(c, 0x89)
        c = emitByte(c, modRM(2, regCode(reg), 5))  // [rbp + disp32]
        c = emitU32(c, 0 - offset)
        return c
    }
    c = emitRexW(c)
    c = emitByte(c, 0x89)
    c = emitByte(c, modRM(1, regCode(reg), 5))  // [rbp + disp8]
    c = emitByte(c, 0 - offset)  // negative offset from rbp
    return c
}

// ============================================================
// Function prologue/epilogue
// ============================================================

func emitFuncPrologue(c: codegen): codegen {
    c = emitPush(c, "rbp")
    c = emitMovR64R64(c, "rbp", "rsp")
    c = emitSubR64Imm8(c, "rsp", 128)
    return c
}

func emitFuncEpilogue(c: codegen): codegen {
    c = emitAddR64Imm8(c, "rsp", 128)
    c = emitPop(c, "rbp")
    c = emitRet(c)
    return c
}

// ============================================================
// Label management
// ============================================================

// label records the current text position for a named label
func label(c: codegen, name: string): codegen {
    c.labels = push(c.labels, name)
    c.labelOffsets = push(c.labelOffsets, #c.text)
    return c
}

func labelData(c: codegen, name: string): codegen {
    c.labels = push(c.labels, name)
    c.labelOffsets = push(c.labelOffsets, #c.text + #c.rodata + #c.data)
    return c
}

func labelRodata(c: codegen, name: string): codegen {
    c.labels = push(c.labels, name)
    c.labelOffsets = push(c.labelOffsets, #c.text + #c.rodata)
    return c
}

func addLabel(c: codegen, name: string): codegen {
    return label(c, name)
}

func nextLabel(c: codegen): u64 {
    c.labelCount = c.labelCount + 1
    return c.labelCount
}
func addString(c: codegen, s: string): codegen {
    let count = #c.strings
    var numStr = ""
    var n = count
    if n == 0
        numStr = "0"
    else
        while n > 0 {
            let digit = n % 10
            var digitStr = ""
            if digit == 0
                digitStr = "0"
            elif digit == 1
                digitStr = "1"
            elif digit == 2
                digitStr = "2"
            elif digit == 3
                digitStr = "3"
            elif digit == 4
                digitStr = "4"
            elif digit == 5
                digitStr = "5"
            elif digit == 6
                digitStr = "6"
            elif digit == 7
                digitStr = "7"
            elif digit == 8
                digitStr = "8"
            else
                digitStr = "9"
            numStr = digitStr + numStr
            n = n / 10
        }
    let labelName = "str_" + numStr
    c.stringLabels = push(c.stringLabels, labelName)
    c.strings = push(c.strings, s)
    c.lastStringLabel = labelName
    return c
}

func emitStringData(c: codegen): codegen {
    for i in 0..#c.strings {
        c = label(c, c.stringLabels[i])
        let s = c.strings[i]
        for j in 0..#s {
            c.text = push(c.text, s[j])
        }
        c.text = push(c.text, 0)
    }
    return c
}
func emitStart(c: codegen): codegen {
    c = label(c, "_start")
    // Save argc and argv to globals (text section is mapped RWX)
    c = emitLeaR64Label(c, "rcx", "__ae_saved_argc")
    c = emitMovR64ToAddr(c, "rdi", "rcx", 0)  // mov [rcx], rdi
    c = emitLeaR64Label(c, "rcx", "__ae_saved_argv")
    c = emitMovR64ToAddr(c, "rsi", "rcx", 0)  // mov [rcx], rsi
    // Initialize heap bump pointer via mmap: allocate an 8MB anonymous
    // region. The old fixed 64KB static arena (__ae_heap_start) overflows
    // when the self-hosted compiler builds an output binary (~1.2MB of
    // text), so the bump pointer now targets mmap'd memory.
    c = emitMovR64Imm64(c, "rdi", 0)           // addr = NULL (kernel chooses)
    c = emitMovR64Imm64(c, "rsi", 8388608)     // len = 8MB
    c = emitMovR64Imm64(c, "rdx", 3)           // prot = PROT_READ|PROT_WRITE
    c = emitMovR64Imm64(c, "r10", 0x1002)      // flags = MAP_PRIVATE|MAP_ANON
    c = emitMovR64Imm64(c, "r8", 0)            // fd = 0 (ignored for MAP_ANON)
    c = emitMovR64Imm64(c, "r9", 0)            // offset = 0
    c = emitMovR64Imm64(c, "rax", 0x20000C5)   // sys_mmap (macOS x86_64)
    c = emitSyscall(c)
    // heap_ptr = mmap result (rax)
    c = emitLeaR64Label(c, "rcx", "__ae_heap_ptr")
    c = emitMovR64ToAddr(c, "rax", "rcx", 0)  // mov [__ae_heap_ptr], rax
    // Call main
    c = emitCallLabel(c, "main")
    // Exit with return code from rax
    c = emitMovR64R64(c, "rdi", "rax")
    c = emitMovR64Imm64(c, "rax", 0x2000001)
    c = emitSyscall(c)
    return c
}

// ============================================================
// Code generation from tokens
// ============================================================

struct genCtx {
    c: codegen,
    pos: u64,
    lastVarName: string,  // last variable evaluated by genPrimary (for member access type lookup)
}

func ctxPeek(ctx: genCtx, tokens: [Token]): Token {
    return tokens[ctx.pos]
}

func ctxIsAtEnd(ctx: genCtx, tokens: [Token]): bool {
	if ctx.pos >= #tokens {
		return true
	}
	return tokens[ctx.pos].typ == TOKEN_EOF
}

func ctxAdvance(ctx: genCtx, tokens: [Token]): genCtx {
    if ctx.pos < #tokens {
        ctx.pos = ctx.pos + 1
    }
    return ctx
}

func ctxCheck(ctx: genCtx, tokens: [Token], typ: u64): bool {
    if ctxIsAtEnd(ctx, tokens) { return false }
    return tokens[ctx.pos].typ == typ
}

func ctxMatch(ctx: genCtx, tokens: [Token], typ: u64): genCtx {
    if ctxCheck(ctx, tokens, typ) { return ctxAdvance(ctx, tokens) }
    return ctx
}

func ctxExpect(ctx: genCtx, tokens: [Token], typ: u64, msg: string): genCtx {
    if ctxCheck(ctx, tokens, typ) { return ctxAdvance(ctx, tokens) }
    ctx.c = codegenAddError(ctx.c, msg)
    return ctx
}

// isTypeKeyword -- check if a token type is a type keyword (u64, i64, bool, etc.)
func isTypeKeyword(typ: u64): bool {
    return typ == TOKEN_KW_BOOL or typ == TOKEN_KW_BYTE or typ == TOKEN_KW_CHAR
        or typ == TOKEN_KW_STRING or typ == TOKEN_KW_VOID
        or typ == TOKEN_KW_INT or typ == TOKEN_KW_FLOAT or typ == TOKEN_KW_DOUBLE
        or typ == TOKEN_KW_U8 or typ == TOKEN_KW_U16 or typ == TOKEN_KW_U32
        or typ == TOKEN_KW_U64 or typ == TOKEN_KW_U128
        or typ == TOKEN_KW_I8 or typ == TOKEN_KW_I16 or typ == TOKEN_KW_I32 or typ == TOKEN_KW_I64
}

// ctxIsTypeKeyword -- true if the current token is a type keyword (u64, i64, etc.)
// Used alongside TOKEN_IDENT checks for type annotations after ':'.
func ctxIsTypeKeyword(ctx: genCtx, tokens: [Token]): bool {
    if ctxIsAtEnd(ctx, tokens) { return false }
    return isTypeKeyword(tokens[ctx.pos].typ)
}

func generate(c: codegen, tokens: [Token]): codegen {
    var ctx: genCtx
    ctx.c = c
    ctx.pos = 0
    // Emit _start entry point FIRST so it's at text offset 0
    // (LC_UNIXTHREAD entry RIP = textVMAddr + textFileOff, which points
    // to the start of the text section -- _start must be there).
    ctx.c = emitStart(ctx.c)
    // Emit all user functions
    while not ctxIsAtEnd(ctx, tokens) {
        while ctxCheck(ctx, tokens, TOKEN_AT) {
            ctx = ctxAdvance(ctx, tokens)
            if ctxCheck(ctx, tokens, TOKEN_IDENT) { ctx = ctxAdvance(ctx, tokens) }
        }
        if ctxCheck(ctx, tokens, TOKEN_KW_FUNC) { ctx = genFunc(ctx, tokens) }
        elif ctxCheck(ctx, tokens, TOKEN_KW_STRUCT) { ctx = skipStructDecl(ctx, tokens) }
        elif ctxCheck(ctx, tokens, TOKEN_KW_ENUM) { ctx = skipEnumDecl(ctx, tokens) }
        elif ctxCheck(ctx, tokens, TOKEN_KW_IMPORT) { ctx = skipImportDecl(ctx, tokens) }
        elif ctxCheck(ctx, tokens, TOKEN_KW_CONST) { ctx = skipConstDecl(ctx, tokens) }
        else { ctx = ctxAdvance(ctx, tokens) }
    }
    // Emit string data (so rodata size is known for labelData)
    ctx.c = emitStringData(ctx.c)
    // Emit runtime helpers (includes emitRuntimeData inside, matching Go bootstrap order)
    ctx.c = emitRuntimeHelpers(ctx.c)

    return ctx.c
}

func skipStructDecl(ctx: genCtx, tokens: [Token]): genCtx {
    ctx = ctxAdvance(ctx, tokens)
    if ctxCheck(ctx, tokens, TOKEN_IDENT) {
        let structName = tokens[ctx.pos].lexeme
        ctx = ctxAdvance(ctx, tokens)
        if ctxCheck(ctx, tokens, TOKEN_LBRACE) {
            ctx = ctxAdvance(ctx, tokens)
            var depth: u64 = 1
            var fieldCount: u64 = 0
            // Track field names + offsets. The field name is the identifier
            // BEFORE the colon. Track the last ident and only record it as
            // a field name once we see a colon after it.
            var lastIdent: string = ""
            var sawIdent: bool = false
            var sawColon: bool = false
            while depth > 0 and not ctxIsAtEnd(ctx, tokens) {
                if ctxCheck(ctx, tokens, TOKEN_LBRACE) { depth = depth + 1; ctx = ctxAdvance(ctx, tokens) }
                elif ctxCheck(ctx, tokens, TOKEN_RBRACE) {
                    // End of struct. If we have a pending field name, record it.
                    if depth == 1 and sawIdent {
                        let key = structName + "." + lastIdent
                        ctx.c.structFields = push(ctx.c.structFields, key)
                        ctx.c.structFieldOffsets = push(ctx.c.structFieldOffsets, fieldCount * 8)
                        fieldCount = fieldCount + 1
                        sawIdent = false
                        sawColon = false
                    }
                    depth = depth - 1
                    ctx = ctxAdvance(ctx, tokens)
                }
                elif ctxCheck(ctx, tokens, TOKEN_COMMA) {
                    // End of previous field. Record if pending.
                    if sawColon and sawIdent {
                        let key = structName + "." + lastIdent
                        ctx.c.structFields = push(ctx.c.structFields, key)
                        ctx.c.structFieldOffsets = push(ctx.c.structFieldOffsets, fieldCount * 8)
                        fieldCount = fieldCount + 1
                        sawIdent = false
                        sawColon = false
                    }
                    ctx = ctxAdvance(ctx, tokens)
                }
                elif ctxCheck(ctx, tokens, TOKEN_COLON) {
                    // Mark that we've seen a colon after a field name.
                    if sawIdent { sawColon = true }
                    ctx = ctxAdvance(ctx, tokens)
                }
                elif ctxCheck(ctx, tokens, TOKEN_IDENT) {
                    // Only overwrite if we don't have a pending field.
                    // (The type name after `:` would otherwise clobber the field name.)
                    if not sawColon {
                        lastIdent = tokens[ctx.pos].lexeme
                        sawIdent = true
                    }
                    ctx = ctxAdvance(ctx, tokens)
                }
                else { ctx = ctxAdvance(ctx, tokens) }
            }
            // Size = max(1, fieldCount) * 8 (each field is 8 bytes; structs always
            // allocate at least 8 bytes so a heap pointer has somewhere to live).
            var size: u64 = fieldCount * 8
            if size == 0 { size = 8 }
            ctx.c.structNames = push(ctx.c.structNames, structName)
            ctx.c.structSizes = push(ctx.c.structSizes, size)
        }
    }
    return ctx
}

func getStructSize(c: codegen, name: string): u64 {
    for i in 0..#c.structNames {
        if c.structNames[i] == name { return c.structSizes[i] }
    }
    return 0
}

func isStructType(c: codegen, name: string): bool {
    for i in 0..#c.structNames {
        if c.structNames[i] == name { return true }
    }
    return false
}

func skipEnumDecl(ctx: genCtx, tokens: [Token]): genCtx {
    ctx = ctxAdvance(ctx, tokens)
    if ctxCheck(ctx, tokens, TOKEN_IDENT) { ctx = ctxAdvance(ctx, tokens) }
    if ctxCheck(ctx, tokens, TOKEN_LBRACE) {
        ctx = ctxAdvance(ctx, tokens)
        var depth: u64 = 1
        while depth > 0 and not ctxIsAtEnd(ctx, tokens) {
            if ctxCheck(ctx, tokens, TOKEN_LBRACE) { depth = depth + 1 }
            elif ctxCheck(ctx, tokens, TOKEN_RBRACE) { depth = depth - 1 }
            ctx = ctxAdvance(ctx, tokens)
        }
    }
    return ctx
}

func skipImportDecl(ctx: genCtx, tokens: [Token]): genCtx {
    ctx = ctxAdvance(ctx, tokens)
    if ctxCheck(ctx, tokens, TOKEN_STRING) { ctx = ctxAdvance(ctx, tokens) }
    return ctx
}

func skipConstDecl(ctx: genCtx, tokens: [Token]): genCtx {
    ctx = ctxAdvance(ctx, tokens)
    if ctxCheck(ctx, tokens, TOKEN_IDENT) { ctx = ctxAdvance(ctx, tokens) }
    if ctxCheck(ctx, tokens, TOKEN_COLON) {
        ctx = ctxAdvance(ctx, tokens)
        // Handle array types: [ElementType]
        if ctxCheck(ctx, tokens, TOKEN_LBRACKET) {
            ctx = ctxAdvance(ctx, tokens)
            if ctxCheck(ctx, tokens, TOKEN_IDENT) or ctxIsTypeKeyword(ctx, tokens) { ctx = ctxAdvance(ctx, tokens) }
            if ctxCheck(ctx, tokens, TOKEN_RBRACKET) { ctx = ctxAdvance(ctx, tokens) }
        } else if ctxCheck(ctx, tokens, TOKEN_IDENT) or ctxIsTypeKeyword(ctx, tokens) { ctx = ctxAdvance(ctx, tokens) }
    }
    if ctxCheck(ctx, tokens, TOKEN_EQUAL) {
        ctx = ctxAdvance(ctx, tokens)
        ctx = skipExpr(ctx, tokens)
    }
    return ctx
}

func skipExpr(ctx: genCtx, tokens: [Token]): genCtx {
    while not ctxIsAtEnd(ctx, tokens) {
        let t = tokens[ctx.pos].typ
        if t == TOKEN_SEMICOLON or t == TOKEN_RBRACE or t == TOKEN_RPAREN or t == TOKEN_COMMA or t == TOKEN_COLON { break }
        ctx = ctxAdvance(ctx, tokens)
    }
    return ctx
}

func genFunc(ctx: genCtx, tokens: [Token]): genCtx {
    ctx = ctxAdvance(ctx, tokens)
    if ctxIsAtEnd(ctx, tokens) {
        ctx.c = codegenAddError(ctx.c, "expected function name")
        return ctx
    }
    let funcName = tokens[ctx.pos].lexeme
    ctx = ctxAdvance(ctx, tokens)
    // Parse param list and capture param names + types.
    // Parameters are passed in rdi, rsi, rdx, rcx, r8, r9 (first 6).
    var paramNames: [string] = []
    var paramTypes: [string] = []
    if ctxCheck(ctx, tokens, TOKEN_LPAREN) {
        ctx = ctxAdvance(ctx, tokens)
        while not ctxCheck(ctx, tokens, TOKEN_RPAREN) and not ctxIsAtEnd(ctx, tokens) {
            if ctxCheck(ctx, tokens, TOKEN_IDENT) {
                let pname = tokens[ctx.pos].lexeme
                paramNames = push(paramNames, pname)
                ctx = ctxAdvance(ctx, tokens)
                var ptype = ""
                if ctxCheck(ctx, tokens, TOKEN_COLON) {
                    ctx = ctxAdvance(ctx, tokens)
                    // Handle array types: [ElementType]
                    if ctxCheck(ctx, tokens, TOKEN_LBRACKET) {
                        ctx = ctxAdvance(ctx, tokens)
                        if ctxCheck(ctx, tokens, TOKEN_IDENT) or ctxIsTypeKeyword(ctx, tokens) {
                            ptype = tokens[ctx.pos].lexeme
                            ctx = ctxAdvance(ctx, tokens)
                        }
                        if ctxCheck(ctx, tokens, TOKEN_RBRACKET) { ctx = ctxAdvance(ctx, tokens) }
                    } else if ctxCheck(ctx, tokens, TOKEN_IDENT) or ctxIsTypeKeyword(ctx, tokens) {
                        ptype = tokens[ctx.pos].lexeme
                        ctx = ctxAdvance(ctx, tokens)
                    }
                }
                paramTypes = push(paramTypes, ptype)
            } else { ctx = ctxAdvance(ctx, tokens) }
            if ctxCheck(ctx, tokens, TOKEN_COMMA) { ctx = ctxAdvance(ctx, tokens) }
        }
        if ctxCheck(ctx, tokens, TOKEN_RPAREN) { ctx = ctxAdvance(ctx, tokens) }
    }
    if ctxCheck(ctx, tokens, TOKEN_COLON) {
        ctx = ctxAdvance(ctx, tokens)
        // Handle array types in return type: [ElementType]
        if ctxCheck(ctx, tokens, TOKEN_LBRACKET) {
            ctx = ctxAdvance(ctx, tokens)
            if ctxCheck(ctx, tokens, TOKEN_IDENT) or ctxIsTypeKeyword(ctx, tokens) { ctx = ctxAdvance(ctx, tokens) }
            if ctxCheck(ctx, tokens, TOKEN_RBRACKET) { ctx = ctxAdvance(ctx, tokens) }
        } else if ctxCheck(ctx, tokens, TOKEN_IDENT) or ctxIsTypeKeyword(ctx, tokens) { ctx = ctxAdvance(ctx, tokens) }
    }
    if not ctxCheck(ctx, tokens, TOKEN_LBRACE) { return ctx }
    ctx.c.funcName = funcName
    ctx.c.stackOffsets = []
    ctx.c.stackOffsetVals = []
    ctx.c.stackSize = 0
    ctx.c.varTypes = []
    ctx.c.labelCount = 0
    ctx.c = label(ctx.c, funcName)
    ctx.c = emitPush(ctx.c, "rbp")
    ctx.c = emitMovR64R64(ctx.c, "rbp", "rsp")
    // First pass: walk body to find local var/let declarations and assign slots.
    // Parameters are pre-allocated BEFORE collectLocals runs so locals continue
    // from the next free offset. We start at offset 8 (NOT 0) so the first param
    // slot is [rbp-8] rather than [rbp-0] = [rbp] -- [rbp] is the slot holding
    // the caller's saved rbp and must not be clobbered by parameters.
    ctx.c.stackSize = 8
    // Register parameters as stack variables so they can be loaded by name.
    for i in 0..#paramNames {
        let pname = paramNames[i]
        var found = false
        for j in 0..#ctx.c.stackOffsets {
            if ctx.c.stackOffsets[j] == pname { found = true }
        }
        if not found {
            ctx.c.stackOffsets = push(ctx.c.stackOffsets, pname)
            ctx.c.stackOffsetVals = push(ctx.c.stackOffsetVals, ctx.c.stackSize)
            ctx.c.stackSize = ctx.c.stackSize + 8
            let ptype = paramTypes[i]
            ctx.c.varTypes = push(ctx.c.varTypes, ptype)
        }
        _ = i
    }
    // First pass: walk body to find local var/let declarations and assign slots.
    ctx = collectLocals(ctx, tokens)
    var stackAlloc: u64 = ctx.c.stackSize
    if stackAlloc < 128 { stackAlloc = 128 }
    // Align to 16 bytes: round up to multiple of 16.
    var alignMask: u64 = 0 - 16
    stackAlloc = (stackAlloc + 15) & alignMask
    if stackAlloc <= 127 {
        ctx.c = emitSubR64Imm8(ctx.c, "rsp", stackAlloc)
    } else {
        ctx.c = emitRexW(ctx.c)
        ctx.c = emitByte(ctx.c, 0x81)
        ctx.c = emitByte(ctx.c, modRM(3, 5, 4))
        ctx.c = emitU32(ctx.c, stackAlloc)
    }
    // Save function parameters (passed in rdi, rsi, rdx, rcx, r8, r9) to their
    // assigned stack slots. After this, references to param names load the
    // correct value via emitMovStackR64.
    let paramRegs = ["rdi", "rsi", "rdx", "rcx", "r8", "r9"]
    for i in 0..#paramNames {
        if i < 6 {
            let reg = paramRegs[i]
            let offset = findStackOffset(ctx.c, paramNames[i])
            ctx.c = emitMovR64Stack(ctx.c, reg, offset)
        }
        _ = i
    }
    ctx = genBlock(ctx, tokens)
    ctx.c = label(ctx.c, funcName + "_epilogue")
    if stackAlloc > 0 {
        if stackAlloc <= 127 {
            ctx.c = emitAddR64Imm8(ctx.c, "rsp", stackAlloc)
        } else {
            ctx.c = emitRexW(ctx.c)
            ctx.c = emitByte(ctx.c, 0x81)
            ctx.c = emitByte(ctx.c, modRM(3, 0, 4))
            ctx.c = emitU32(ctx.c, stackAlloc)
        }
    }
    ctx.c = emitPop(ctx.c, "rbp")
    ctx.c = emitRet(ctx.c)
    return ctx
}

func collectLocals(ctx: genCtx, tokens: [Token]): genCtx {
    let savedPos = ctx.pos
    ctx = collectLocalsWalk(ctx, tokens)
    ctx.pos = savedPos
    return ctx
}

func collectLocalsWalk(ctx: genCtx, tokens: [Token]): genCtx {
    while not ctxIsAtEnd(ctx, tokens) {
        if ctxCheck(ctx, tokens, TOKEN_KW_LET) or ctxCheck(ctx, tokens, TOKEN_KW_VAR) {
            ctx = ctxAdvance(ctx, tokens)
            if ctxCheck(ctx, tokens, TOKEN_IDENT) {
                let varName = tokens[ctx.pos].lexeme
                var found = false
                for j in 0..#ctx.c.stackOffsets {
                    if ctx.c.stackOffsets[j] == varName { found = true }
                }
                if not found {
                    ctx.c.stackOffsets = push(ctx.c.stackOffsets, varName)
                    ctx.c.stackOffsetVals = push(ctx.c.stackOffsetVals, ctx.c.stackSize)
                    ctx.c.stackSize = ctx.c.stackSize + 8
                }
                ctx = ctxAdvance(ctx, tokens)
                // Record the variable's type (if annotated)
                var vtype = ""
                if ctxCheck(ctx, tokens, TOKEN_COLON) {
                    ctx = ctxAdvance(ctx, tokens)
                    // Handle array types: [ElementType]
                    if ctxCheck(ctx, tokens, TOKEN_LBRACKET) {
                        ctx = ctxAdvance(ctx, tokens)
                        if ctxCheck(ctx, tokens, TOKEN_IDENT) or ctxIsTypeKeyword(ctx, tokens) {
                            vtype = tokens[ctx.pos].lexeme
                            ctx = ctxAdvance(ctx, tokens)
                        }
                        if ctxCheck(ctx, tokens, TOKEN_RBRACKET) { ctx = ctxAdvance(ctx, tokens) }
                    } else if ctxCheck(ctx, tokens, TOKEN_IDENT) or ctxIsTypeKeyword(ctx, tokens) {
                        vtype = tokens[ctx.pos].lexeme
                        ctx = ctxAdvance(ctx, tokens)
                    }
                }
                ctx.c.varTypes = push(ctx.c.varTypes, vtype)
            }
        } elif ctxCheck(ctx, tokens, TOKEN_LBRACE) {
            ctx = ctxAdvance(ctx, tokens)
            ctx = collectLocalsWalk(ctx, tokens)
        } elif ctxCheck(ctx, tokens, TOKEN_RBRACE) {
            ctx = ctxAdvance(ctx, tokens)
            return ctx
        } else { ctx = ctxAdvance(ctx, tokens) }
    }
    return ctx
}

func getVarType(c: codegen, name: string): string {
    for i in 0..#c.stackOffsets {
        if c.stackOffsets[i] == name { return c.varTypes[i] }
    }
    return ""
}

func findStackOffset(c: codegen, name: string): u64 {
    for i in 0..#c.stackOffsets {
        if c.stackOffsets[i] == name { return c.stackOffsetVals[i] }
    }
    return 0
}

func isStackVar(c: codegen, name: string): bool {
    for i in 0..#c.stackOffsets {
        if c.stackOffsets[i] == name { return true }
    }
    return false
}

func genBlock(ctx: genCtx, tokens: [Token]): genCtx {
    if ctxCheck(ctx, tokens, TOKEN_LBRACE) { ctx = ctxAdvance(ctx, tokens) }
    while not ctxCheck(ctx, tokens, TOKEN_RBRACE) and not ctxIsAtEnd(ctx, tokens) {
        ctx = genStmt(ctx, tokens)
    }
    if ctxCheck(ctx, tokens, TOKEN_RBRACE) { ctx = ctxAdvance(ctx, tokens) }
    return ctx
}

func genStmt(ctx: genCtx, tokens: [Token]): genCtx {
    if ctxCheck(ctx, tokens, TOKEN_KW_LET) or ctxCheck(ctx, tokens, TOKEN_KW_VAR) { return genVarDecl(ctx, tokens) }
    if ctxCheck(ctx, tokens, TOKEN_KW_RETURN) { return genReturnStmt(ctx, tokens) }
    if ctxCheck(ctx, tokens, TOKEN_KW_IF) { return genIfStmt(ctx, tokens) }
    if ctxCheck(ctx, tokens, TOKEN_KW_WHILE) { return genWhileStmt(ctx, tokens) }
    if ctxCheck(ctx, tokens, TOKEN_KW_FOR) { return genForStmt(ctx, tokens) }
    if ctxCheck(ctx, tokens, TOKEN_KW_MATCH) { return genMatchStmt(ctx, tokens) }
    if ctxCheck(ctx, tokens, TOKEN_KW_BREAK) {
        ctx = ctxAdvance(ctx, tokens)
        ctx.c = emitJmpLabel(ctx.c, ctx.c.funcName + "_break")
        return ctx
    }
    if ctxCheck(ctx, tokens, TOKEN_KW_CONTINUE) {
        ctx = ctxAdvance(ctx, tokens)
        ctx.c = emitJmpLabel(ctx.c, ctx.c.funcName + "_continue")
        return ctx
    }
    if ctxCheck(ctx, tokens, TOKEN_LBRACE) { return genBlock(ctx, tokens) }
    // Check for assignment: ident = expr
    // Use ctxPeek to look at current token, and check if the token AFTER
    // the next IDENT is EQUAL. We do this by advancing past IDENT and checking
    // for EQUAL, without needing to peek at ctx.pos + 1 (which requires
    // struct field access on ctx).
    if ctxCheck(ctx, tokens, TOKEN_IDENT) {
        let name = tokens[ctx.pos].lexeme
        // Look ahead: is the NEXT token EQUAL?
        let nextPos = ctx.pos + 1
        if nextPos < #tokens and tokens[nextPos].typ == TOKEN_EQUAL {
            ctx = ctxAdvance(ctx, tokens)  // skip ident
            ctx = ctxAdvance(ctx, tokens)  // skip =
            ctx = genExpr(ctx, tokens)
            if isStackVar(ctx.c, name) {
                let offset = findStackOffset(ctx.c, name)
                ctx.c = emitMovR64Stack(ctx.c, "rax", offset)
            }
            return ctx
        }
    }
    ctx = genExpr(ctx, tokens)
    return ctx
}

func genVarDecl(ctx: genCtx, tokens: [Token]): genCtx {
    ctx = ctxAdvance(ctx, tokens)
    if ctxCheck(ctx, tokens, TOKEN_IDENT) {
        let varName = tokens[ctx.pos].lexeme
        ctx = ctxAdvance(ctx, tokens)
        var typeName = ""
        if ctxCheck(ctx, tokens, TOKEN_COLON) {
            ctx = ctxAdvance(ctx, tokens)
            // Handle array types: [ElementType]
            if ctxCheck(ctx, tokens, TOKEN_LBRACKET) {
                ctx = ctxAdvance(ctx, tokens)
                if ctxCheck(ctx, tokens, TOKEN_IDENT) or ctxIsTypeKeyword(ctx, tokens) {
                    typeName = tokens[ctx.pos].lexeme
                    ctx = ctxAdvance(ctx, tokens)
                }
                if ctxCheck(ctx, tokens, TOKEN_RBRACKET) { ctx = ctxAdvance(ctx, tokens) }
            } else if ctxCheck(ctx, tokens, TOKEN_IDENT) or ctxIsTypeKeyword(ctx, tokens) {
                typeName = tokens[ctx.pos].lexeme
                ctx = ctxAdvance(ctx, tokens)
            }
        }
        if ctxCheck(ctx, tokens, TOKEN_EQUAL) {
            ctx = ctxAdvance(ctx, tokens)
            ctx = genExpr(ctx, tokens)
            let offset = findStackOffset(ctx.c, varName)
            ctx.c = emitMovR64Stack(ctx.c, "rax", offset)
        } elif isStructType(ctx.c, typeName) {
            // No initializer: allocate the struct on the heap so field
            // assignments (l.field = v) have a valid target.
            let size = getStructSize(ctx.c, typeName)
            ctx.c = emitMovR64Imm64(ctx.c, "rdi", size)
            ctx.c = emitCallLabel(ctx.c, "__ae_alloc")
            let offset = findStackOffset(ctx.c, varName)
            ctx.c = emitMovR64Stack(ctx.c, "rax", offset)
        }
    }
    return ctx
}

func genReturnStmt(ctx: genCtx, tokens: [Token]): genCtx {
    ctx = ctxAdvance(ctx, tokens)
    if not ctxCheck(ctx, tokens, TOKEN_RBRACE) and not ctxCheck(ctx, tokens, TOKEN_SEMICOLON) {
        ctx = genExpr(ctx, tokens)
    }
    ctx.c = emitJmpLabel(ctx.c, ctx.c.funcName + "_epilogue")
    return ctx
}

func genIfStmt(ctx: genCtx, tokens: [Token]): genCtx {
    ctx = ctxAdvance(ctx, tokens)
    ctx = genExpr(ctx, tokens)
    ctx.c = emitTestR64R64(ctx.c, "rax", "rax")
    let elseLabel = ctx.c.funcName + "_else_" + u64ToString(nextLabel(ctx.c))
    ctx.c = emitJzLabel(ctx.c, elseLabel)
    ctx = genStmt(ctx, tokens)
    if ctxCheck(ctx, tokens, TOKEN_KW_ELIF) {
        let endLabel = ctx.c.funcName + "_end_" + u64ToString(nextLabel(ctx.c))
        ctx.c = emitJmpLabel(ctx.c, endLabel)
        ctx.c = label(ctx.c, elseLabel)
        ctx = genIfStmt(ctx, tokens)
        ctx.c = label(ctx.c, endLabel)
        return ctx
    }
    if ctxCheck(ctx, tokens, TOKEN_KW_ELSE) {
        ctx = ctxAdvance(ctx, tokens)
        let endLabel = ctx.c.funcName + "_end_" + u64ToString(nextLabel(ctx.c))
        ctx.c = emitJmpLabel(ctx.c, endLabel)
        ctx.c = label(ctx.c, elseLabel)
        ctx = genStmt(ctx, tokens)
        ctx.c = label(ctx.c, endLabel)
        return ctx
    }
    ctx.c = label(ctx.c, elseLabel)
    return ctx
}

func genWhileStmt(ctx: genCtx, tokens: [Token]): genCtx {
    let startLabel = ctx.c.funcName + "_start_" + u64ToString(nextLabel(ctx.c))
    let endLabel = ctx.c.funcName + "_end_" + u64ToString(nextLabel(ctx.c))
    ctx.c = label(ctx.c, startLabel)
    ctx = ctxAdvance(ctx, tokens)
    ctx = genExpr(ctx, tokens)
    ctx.c = emitTestR64R64(ctx.c, "rax", "rax")
    ctx.c = emitJzLabel(ctx.c, endLabel)
    ctx = genStmt(ctx, tokens)
    ctx.c = emitJmpLabel(ctx.c, startLabel)
    ctx.c = label(ctx.c, endLabel)
    return ctx
}

func genForStmt(ctx: genCtx, tokens: [Token]): genCtx {
    ctx = ctxAdvance(ctx, tokens)
    ctx = skipExpr(ctx, tokens)
    if ctxCheck(ctx, tokens, TOKEN_LBRACE) { ctx = genBlock(ctx, tokens) }
    return ctx
}

func genMatchStmt(ctx: genCtx, tokens: [Token]): genCtx {
    ctx = ctxAdvance(ctx, tokens)
    ctx = genExpr(ctx, tokens)
    ctx.c = emitPush(ctx.c, "rax")
    if ctxCheck(ctx, tokens, TOKEN_LBRACE) { ctx = ctxAdvance(ctx, tokens) }
    let endLabel = ctx.c.funcName + "_match_end_" + u64ToString(nextLabel(ctx.c))
    while not ctxCheck(ctx, tokens, TOKEN_RBRACE) and not ctxIsAtEnd(ctx, tokens) {
        if ctxCheck(ctx, tokens, TOKEN_KW_CASE) {
            ctx = ctxAdvance(ctx, tokens)
            while not ctxCheck(ctx, tokens, TOKEN_ARROW) and not ctxIsAtEnd(ctx, tokens) { ctx = ctxAdvance(ctx, tokens) }
            if ctxCheck(ctx, tokens, TOKEN_ARROW) { ctx = ctxAdvance(ctx, tokens) }
            ctx = genStmt(ctx, tokens)
            ctx.c = emitJmpLabel(ctx.c, endLabel)
        } elif ctxCheck(ctx, tokens, TOKEN_KW_ELSE) {
            ctx = ctxAdvance(ctx, tokens)
            if ctxCheck(ctx, tokens, TOKEN_ARROW) { ctx = ctxAdvance(ctx, tokens) }
            ctx = genStmt(ctx, tokens)
        } else { ctx = ctxAdvance(ctx, tokens) }
    }
    if ctxCheck(ctx, tokens, TOKEN_RBRACE) { ctx = ctxAdvance(ctx, tokens) }
    ctx.c = emitPop(ctx.c, "rax")
    ctx.c = label(ctx.c, endLabel)
    return ctx
}

func genExpr(ctx: genCtx, tokens: [Token]): genCtx {
    if ctxCheck(ctx, tokens, TOKEN_MINUS) {
        ctx = ctxAdvance(ctx, tokens); ctx = genExpr(ctx, tokens)
        ctx.c = emitNegR64(ctx.c, "rax"); return ctx
    }
    if ctxCheck(ctx, tokens, TOKEN_EXCLAIM) {
        ctx = ctxAdvance(ctx, tokens); ctx = genExpr(ctx, tokens)
        ctx.c = emitTestR64R64(ctx.c, "rax", "rax")
        ctx.c = emitSete(ctx.c, "al"); ctx.c = emitMovzxR64R8(ctx.c, "rax", "al"); return ctx
    }
    if ctxCheck(ctx, tokens, TOKEN_TILDE) {
        ctx = ctxAdvance(ctx, tokens); ctx = genExpr(ctx, tokens)
        ctx.c = emitNotR64(ctx.c, "rax"); return ctx
    }
    if ctxCheck(ctx, tokens, TOKEN_HASH) {
        ctx = ctxAdvance(ctx, tokens); ctx = genExpr(ctx, tokens)
        ctx.c = emitPush(ctx.c, "rax"); ctx.c = emitPop(ctx.c, "rdi")
        ctx.c = emitCallLabel(ctx.c, "__ae_len"); return ctx
    }
    ctx = genPrimary(ctx, tokens)
    while true {
        if ctxCheck(ctx, tokens, TOKEN_LPAREN) { ctx = genCallArgs(ctx, tokens) }
        elif ctxCheck(ctx, tokens, TOKEN_LBRACKET) {
            // Save the object pointer (in rax) before evaluating the index,
            // which clobbers rax. Matches Go bootstrap emitIndexExpr.
            ctx.c = emitPush(ctx.c, "rax")
            ctx = ctxAdvance(ctx, tokens); ctx = genExpr(ctx, tokens)
            // Slice: obj[start:end]
            if ctxCheck(ctx, tokens, TOKEN_COLON) {
                ctx.c = emitPush(ctx.c, "rax")  // start
                ctx = ctxAdvance(ctx, tokens); ctx = genExpr(ctx, tokens)  // end -> rax
                ctx.c = emitMovR64R64(ctx.c, "rdx", "rax")  // end
                ctx.c = emitPop(ctx.c, "rsi")   // start (top of stack)
                ctx.c = emitPop(ctx.c, "rdi")   // object
                ctx.c = emitCallLabel(ctx.c, "__ae_slice")
                if ctxCheck(ctx, tokens, TOKEN_RBRACKET) { ctx = ctxAdvance(ctx, tokens) }
            } else {
                ctx.c = emitPop(ctx.c, "rdi"); ctx.c = emitMovR64R64(ctx.c, "rsi", "rax")
                ctx.c = emitCallLabel(ctx.c, "__ae_index")
                if ctxCheck(ctx, tokens, TOKEN_RBRACKET) { ctx = ctxAdvance(ctx, tokens) }
            }
        }
        elif ctxCheck(ctx, tokens, TOKEN_DOT) {
            ctx = ctxAdvance(ctx, tokens)
            if ctxCheck(ctx, tokens, TOKEN_IDENT) {
                let fieldName = tokens[ctx.pos].lexeme; ctx = ctxAdvance(ctx, tokens)
                // Determine the struct type of the object (from the last variable evaluated)
                let objType = getVarType(ctx.c, ctx.lastVarName)
                var getterLabel = "__ae_field_" + fieldName
                var setterLabel = "__ae_field_set_" + fieldName
                if isStructType(ctx.c, objType) {
                    getterLabel = "__ae_field_" + objType + "_" + fieldName
                    setterLabel = "__ae_field_set_" + objType + "_" + fieldName
                }
                if ctxCheck(ctx, tokens, TOKEN_EQUAL) {
                    // Member assignment: obj.field = value
                    // rax currently holds the struct pointer. Save it.
                    ctx.c = emitPush(ctx.c, "rax")
                    ctx = ctxAdvance(ctx, tokens)  // skip '='
                    ctx = genExpr(ctx, tokens)     // evaluate RHS -> rax = value
                    ctx.c = emitPush(ctx.c, "rax") // push value
                    ctx.c = emitPop(ctx.c, "rsi")  // rsi = value
                    ctx.c = emitPop(ctx.c, "rdi")  // rdi = struct pointer
                    ctx.c = emitCallLabel(ctx.c, setterLabel)
                } else {
                    ctx.c = emitPush(ctx.c, "rax"); ctx.c = emitPop(ctx.c, "rdi")
                    ctx.c = emitCallLabel(ctx.c, getterLabel)
                }
            }
        }
        elif ctxCheck(ctx, tokens, TOKEN_PLUS_PLUS) { ctx = ctxAdvance(ctx, tokens); ctx.c = emitAddR64Imm8(ctx.c, "rax", 1) }
        elif ctxCheck(ctx, tokens, TOKEN_MINUS_MINUS) { ctx = ctxAdvance(ctx, tokens); ctx.c = emitSubR64Imm8(ctx.c, "rax", 1) }
        else { break }
    }
    if isBinaryOp(tokens[ctx.pos].typ) { ctx = genBinaryOp(ctx, tokens) }
    return ctx
}

func isBinaryOp(typ: u64): bool {
    if typ == TOKEN_PLUS or typ == TOKEN_MINUS or typ == TOKEN_STAR or typ == TOKEN_SLASH or typ == TOKEN_PERCENT { return true }
    if typ == TOKEN_EQUAL_EQUAL or typ == TOKEN_EXCLAIM_EQUAL or typ == TOKEN_LESS or typ == TOKEN_GREATER { return true }
    if typ == TOKEN_LESS_EQUAL or typ == TOKEN_GREATER_EQUAL { return true }
    if typ == TOKEN_AMPERSAND_AMPERSAND or typ == TOKEN_PIPE_PIPE { return true }
    if typ == TOKEN_AMPERSAND or typ == TOKEN_PIPE or typ == TOKEN_CARET { return true }
    if typ == TOKEN_LESS_LESS or typ == TOKEN_GREATER_GREATER { return true }
    if typ == TOKEN_KW_AND or typ == TOKEN_KW_OR { return true }
    return false
}

func genBinaryOp(ctx: genCtx, tokens: [Token]): genCtx {
    let op = tokens[ctx.pos].typ; ctx = ctxAdvance(ctx, tokens)
    // Detect a string-typed left operand so == / != / + dispatch to the
    // string helpers instead of raw pointer/integer compares.
    var leftIsString = false
    let lname = ctx.lastVarName
    if lname != "" {
        let lt = getVarType(ctx.c, lname)
        if lt == "string" { leftIsString = true }
    }
    ctx.c = emitPush(ctx.c, "rax")
    ctx = genExpr(ctx, tokens)
    ctx.c = emitPop(ctx.c, "rbx")
    // String ops: left was pushed (rax) and right is in rax.
    if op == TOKEN_PLUS and leftIsString {
        ctx.c = emitMovR64R64(ctx.c, "rdi", "rbx")
        ctx.c = emitMovR64R64(ctx.c, "rsi", "rax")
        ctx.c = emitCallLabel(ctx.c, "__ae_str_concat")
        return ctx
    }
    if op == TOKEN_EQUAL_EQUAL and leftIsString {
        ctx.c = emitMovR64R64(ctx.c, "rdi", "rbx")
        ctx.c = emitMovR64R64(ctx.c, "rsi", "rax")
        ctx.c = emitCallLabel(ctx.c, "__ae_str_eq")
        return ctx
    }
    if op == TOKEN_EXCLAIM_EQUAL and leftIsString {
        ctx.c = emitMovR64R64(ctx.c, "rdi", "rbx")
        ctx.c = emitMovR64R64(ctx.c, "rsi", "rax")
        ctx.c = emitCallLabel(ctx.c, "__ae_str_eq")
        ctx.c = emitTestR64R64(ctx.c, "rax", "rax")
        ctx.c = emitSete(ctx.c, "al"); ctx.c = emitMovzxR64R8(ctx.c, "rax", "al")
        return ctx
    }
    if op == TOKEN_PLUS { ctx.c = emitAddR64R64(ctx.c, "rax", "rbx") }
    elif op == TOKEN_MINUS { ctx.c = emitSubR64R64(ctx.c, "rbx", "rax"); ctx.c = emitMovR64R64(ctx.c, "rax", "rbx") }
    elif op == TOKEN_STAR { ctx.c = emitMulR64(ctx.c, "rbx") }
    elif op == TOKEN_SLASH {
        // rax=right, rbx=left; swap via rcx then div rbx -> rax = left/right
        ctx.c = emitMovR64R64(ctx.c, "rcx", "rax")
        ctx.c = emitMovR64R64(ctx.c, "rax", "rbx")
        ctx.c = emitMovR64R64(ctx.c, "rbx", "rcx")
        ctx.c = emitDivR64(ctx.c, "rbx")
    }
    elif op == TOKEN_EQUAL_EQUAL { ctx.c = emitCmpR64R64(ctx.c, "rbx", "rax"); ctx.c = emitSete(ctx.c, "al"); ctx.c = emitMovzxR64R8(ctx.c, "rax", "al") }
    elif op == TOKEN_EXCLAIM_EQUAL { ctx.c = emitCmpR64R64(ctx.c, "rbx", "rax"); ctx.c = emitSetne(ctx.c, "al"); ctx.c = emitMovzxR64R8(ctx.c, "rax", "al") }
    elif op == TOKEN_LESS { ctx.c = emitCmpR64R64(ctx.c, "rbx", "rax"); ctx.c = emitSetl(ctx.c, "al"); ctx.c = emitMovzxR64R8(ctx.c, "rax", "al") }
    elif op == TOKEN_GREATER { ctx.c = emitCmpR64R64(ctx.c, "rbx", "rax"); ctx.c = emitSetg(ctx.c, "al"); ctx.c = emitMovzxR64R8(ctx.c, "rax", "al") }
    elif op == TOKEN_LESS_EQUAL { ctx.c = emitCmpR64R64(ctx.c, "rbx", "rax"); ctx.c = emitSetle(ctx.c, "al"); ctx.c = emitMovzxR64R8(ctx.c, "rax", "al") }
    elif op == TOKEN_GREATER_EQUAL { ctx.c = emitCmpR64R64(ctx.c, "rbx", "rax"); ctx.c = emitSetge(ctx.c, "al"); ctx.c = emitMovzxR64R8(ctx.c, "rax", "al") }
    elif op == TOKEN_AMPERSAND { ctx.c = emitAndR64R64(ctx.c, "rax", "rbx") }
    elif op == TOKEN_PIPE { ctx.c = emitOrR64R64(ctx.c, "rax", "rbx") }
    elif op == TOKEN_CARET { ctx.c = emitXorR64R64(ctx.c, "rax", "rbx") }
    elif op == TOKEN_LESS_LESS {
        // Shift amount in rax -> rcx; value in rbx. shl rbx, cl.
        ctx.c = emitMovR64R64(ctx.c, "rcx", "rax")
        ctx.c = emitShlR64(ctx.c, "rbx")
        ctx.c = emitMovR64R64(ctx.c, "rax", "rbx")
    }
    elif op == TOKEN_GREATER_GREATER {
        // Shift amount in rax -> rcx; value in rbx. shr rbx, cl.
        ctx.c = emitMovR64R64(ctx.c, "rcx", "rax")
        ctx.c = emitShrR64(ctx.c, "rbx")
        ctx.c = emitMovR64R64(ctx.c, "rax", "rbx")
    }
    else { ctx.c = emitMovR64R64(ctx.c, "rax", "rbx") }
    return ctx
}

func genPrimary(ctx: genCtx, tokens: [Token]): genCtx {
    if ctxCheck(ctx, tokens, TOKEN_INTEGER) {
        let val = parseU64(tokens[ctx.pos].lexeme)
        ctx.c = emitMovR64Imm64(ctx.c, "rax", val); ctx = ctxAdvance(ctx, tokens); return ctx
    }
    if ctxCheck(ctx, tokens, TOKEN_STRING) {
        let s = tokens[ctx.pos].literal
        if s == "" {
            s = tokens[ctx.pos].lexeme
            if #s >= 2 { s = s[1:#s-1] }
        }
        ctx.c = addString(ctx.c, s)
        ctx.c = emitLeaR64Label(ctx.c, "rax", ctx.c.lastStringLabel)
        ctx = ctxAdvance(ctx, tokens); return ctx
    }
    if ctxCheck(ctx, tokens, TOKEN_CHAR) {
        let ch = tokens[ctx.pos].lexeme
        var val: u64 = 0
        if #ch > 0 { val = ch[0] }
        ctx.c = emitMovR64Imm64(ctx.c, "rax", val); ctx = ctxAdvance(ctx, tokens); return ctx
    }
    if ctxCheck(ctx, tokens, TOKEN_KW_TRUE) { ctx.c = emitMovR64Imm64(ctx.c, "rax", 1); ctx = ctxAdvance(ctx, tokens); return ctx }
    if ctxCheck(ctx, tokens, TOKEN_KW_FALSE) { ctx.c = emitMovR64Imm64(ctx.c, "rax", 0); ctx = ctxAdvance(ctx, tokens); return ctx }
    if ctxCheck(ctx, tokens, TOKEN_KW_NONE) { ctx.c = emitXorR64R64(ctx.c, "rax", "rax"); ctx = ctxAdvance(ctx, tokens); return ctx }
    if ctxCheck(ctx, tokens, TOKEN_IDENT) {
        let name = tokens[ctx.pos].lexeme; ctx = ctxAdvance(ctx, tokens)
        if isStackVar(ctx.c, name) {
            let offset = findStackOffset(ctx.c, name)
            ctx.c = emitMovStackR64(ctx.c, "rax", offset)
            ctx.lastVarName = name
        } else { ctx.c.lastCallee = name }
        return ctx
    }
    if ctxCheck(ctx, tokens, TOKEN_LPAREN) {
        ctx = ctxAdvance(ctx, tokens); ctx = genExpr(ctx, tokens)
        if ctxCheck(ctx, tokens, TOKEN_RPAREN) { ctx = ctxAdvance(ctx, tokens) }
        return ctx
    }
    ctx = ctxAdvance(ctx, tokens)
    return ctx
}

func genCallArgs(ctx: genCtx, tokens: [Token]): genCtx {
    var calleeName = ctx.c.lastCallee; ctx.c.lastCallee = ""
    ctx = ctxAdvance(ctx, tokens)
    var argCount: u64 = 0
    while not ctxCheck(ctx, tokens, TOKEN_RPAREN) and not ctxIsAtEnd(ctx, tokens) {
        if argCount > 0 {
            if ctxCheck(ctx, tokens, TOKEN_COMMA) { ctx = ctxAdvance(ctx, tokens) }
        }
        ctx = genExpr(ctx, tokens)
        ctx.c = emitPush(ctx.c, "rax")
        argCount = argCount + 1
    }
    if ctxCheck(ctx, tokens, TOKEN_RPAREN) { ctx = ctxAdvance(ctx, tokens) }
    // Pop in reverse order so arg1 (pushed first) lands in rdi, arg2 in rsi, etc.
    let regs = ["rdi", "rsi", "rdx", "rcx", "r8", "r9"]
    var i: u64 = argCount
    if i > 6 { i = 6 }
    while i > 0 {
        i = i - 1
        ctx.c = emitPop(ctx.c, regs[i])
    }
    if calleeName == "" { calleeName = "_unknown_call" }
    ctx.c = emitCallLabel(ctx.c, calleeName)
    return ctx
}

func parseU64(s: string): u64 {
    var result: u64 = 0
    for i in 0..#s {
        let c = s[i]
        if c >= 48 and c <= 57 { result = result * 10 + (c - 48) }
    }
    return result
}

func u64ToString(val: u64): string {
    if val == 0 { return "0" }
    var result = ""; var n = val
    while n > 0 {
        let digit = n % 10; var digitStr = ""
        if digit == 0 { digitStr = "0" }
        elif digit == 1 { digitStr = "1" }
        elif digit == 2 { digitStr = "2" }
        elif digit == 3 { digitStr = "3" }
        elif digit == 4 { digitStr = "4" }
        elif digit == 5 { digitStr = "5" }
        elif digit == 6 { digitStr = "6" }
        elif digit == 7 { digitStr = "7" }
        elif digit == 8 { digitStr = "8" }
        else { digitStr = "9" }
        result = digitStr + result; n = n / 10
    }
    return result
}

// ============================================================
// Runtime helpers
// ============================================================

func emitRuntimeHelpers(c: codegen): codegen {
    // Data section: saved argc/argv, read buffer, heap -- emitted FIRST
    // (matching Go bootstrap order: emitRuntimeData is called inside emitRuntimeHelpers)
    c = emitRuntimeData(c)
    c = emitAePrint(c); c = emitAeExit(c); c = emitAeWriteFile(c)
    c = emitAeReadFile(c); c = emitAeGetArg(c); c = emitAeArgc(c)
    c = emitAeFork(c); c = emitAeExecve(c); c = emitAeWait4(c); c = emitAePipe(c)
    c = emitAeSystem(c)
    c = emitAeLen(c); c = emitAeIndex(c); c = emitAeIndexSet(c)
    c = emitAeSlice(c)
    c = emitAeAlloc(c)
    c = emitAeArrayNew(c); c = emitAeStrConcat(c); c = emitAeStrEq(c)
    c = emitAePush(c); c = emitAePop(c); c = emitPushBuiltin(c)
    c = emitLogicalHelpers(c); c = emitStructFieldHelpers(c)
    return c
}

func emitRuntimeData(c: codegen): codegen {
    c = label(c, "__ae_saved_argc")
    for i in 0..8 { c.text = push(c.text, 0) }
    c = label(c, "__ae_saved_argv")
    for i in 0..8 { c.text = push(c.text, 0) }
    c = label(c, "__ae_read_buf")
    for i in 0..4096 { c.text = push(c.text, 0) }
    c = label(c, "__ae_empty_str")
    c.text = push(c.text, 0)
    // /bin/sh path for __ae_system
    c = label(c, "__ae_sh_path")
    for i in 0..#"/bin/sh" { c.text = push(c.text, "/bin/sh"[i]) }
    c.text = push(c.text, 0)
    // "-c" flag for __ae_system
    c = label(c, "__ae_sh_c")
    c.text = push(c.text, 45)  // '-'
    c.text = push(c.text, 99)  // 'c'
    c.text = push(c.text, 0)
    c = label(c, "__ae_heap_start")
    for i in 0..65536 { c.text = push(c.text, 0) }
    c = label(c, "__ae_heap_ptr")
    for i in 0..8 { c.text = push(c.text, 0) }
    return c
}

func emitAePrint(c: codegen): codegen {
    c = label(c, "__ae_print")
    c = emitPush(c, "rbp"); c = emitMovR64R64(c, "rbp", "rsp")
    c = emitPush(c, "rdi"); c = emitPush(c, "rsi"); c = emitPush(c, "rdx")
    c = emitPush(c, "rcx"); c = emitPush(c, "r8"); c = emitPush(c, "r9")
    c = emitMovR64R64(c, "rsi", "rdi"); c = emitXorR64R64(c, "rdx", "rdx")
    c = label(c, "__ae_print_strlen")
    c = emitByte(c, 0x80); c = emitByte(c, 0x3C); c = emitByte(c, 0x16); c = emitByte(c, 0x00)
    c = emitJzLabel(c, "__ae_print_done")
    c = emitAddR64Imm8(c, "rdx", 1)
    c = emitJmpLabel(c, "__ae_print_strlen")
    c = label(c, "__ae_print_done")
    c = emitMovR64Imm64(c, "rax", 0x2000004)
    c = emitMovR64Imm64(c, "rdi", 1)
    c = emitSyscall(c)
    c = emitPop(c, "r9"); c = emitPop(c, "r8"); c = emitPop(c, "rcx")
    c = emitPop(c, "rdx"); c = emitPop(c, "rsi"); c = emitPop(c, "rdi")
    c = emitPop(c, "rbp"); c = emitRet(c)
    return c
}

func emitAeExit(c: codegen): codegen {
    c = label(c, "__ae_exit")
    c = emitPush(c, "rbp"); c = emitMovR64R64(c, "rbp", "rsp")
    c = emitMovR64Imm64(c, "rax", 0x2000001)
    c = emitSyscall(c)
    c = emitPop(c, "rbp"); c = emitRet(c)
    return c
}

func emitAeFork(c: codegen): codegen {
    // __ae_fork: fork() syscall (macOS x86_64: 0x2000002)
    // No args. Returns child PID in parent, 0 in child, -1 on error.
    c = label(c, "__ae_fork")
    c = emitPush(c, "rbp"); c = emitMovR64R64(c, "rbp", "rsp")
    c = emitMovR64Imm64(c, "rax", 0x2000002)
    c = emitSyscall(c)
    c = emitPop(c, "rbp"); c = emitRet(c)
    return c
}

func emitAeExecve(c: codegen): codegen {
    // __ae_execve: execve(path, argv, envp) syscall (macOS x86_64: 0x200003B)
    // rdi = path pointer, rsi = argv array pointer, rdx = envp pointer.
    // Never returns on success; returns -1 on error.
    c = label(c, "__ae_execve")
    c = emitPush(c, "rbp"); c = emitMovR64R64(c, "rbp", "rsp")
    c = emitMovR64Imm64(c, "rax", 0x200003B)
    c = emitSyscall(c)
    c = emitPop(c, "rbp"); c = emitRet(c)
    return c
}

func emitAeWait4(c: codegen): codegen {
    // __ae_wait4: wait4(pid, status, options, rusage) syscall (macOS x86_64: 0x2000007)
    // rdi = pid, rsi = status pointer, rdx = options, rcx = rusage pointer.
    // Returns child PID.
    c = label(c, "__ae_wait4")
    c = emitPush(c, "rbp"); c = emitMovR64R64(c, "rbp", "rsp")
    c = emitMovR64Imm64(c, "rax", 0x2000007)
    c = emitSyscall(c)
    c = emitPop(c, "rbp"); c = emitRet(c)
    return c
}

func emitAePipe(c: codegen): codegen {
    // __ae_pipe: pipe(fds) syscall (macOS x86_64: 0x200002A)
    // rdi = pointer to int[2]. Returns 0 on success, -1 on error.
    c = label(c, "__ae_pipe")
    c = emitPush(c, "rbp"); c = emitMovR64R64(c, "rbp", "rsp")
    c = emitMovR64Imm64(c, "rax", 0x200002A)
    c = emitSyscall(c)
    c = emitPop(c, "rbp"); c = emitRet(c)
    return c
}

func emitAeSystem(c: codegen): codegen {
    // __ae_system: run a shell command via fork + execve("/bin/sh", ["sh","-c",cmd]) + wait4.
    // rdi = pointer to null-terminated command string.
    // Returns the child's exit status (wait4 status) in rax, or -1 on fork error.
    c = label(c, "__ae_system")
    c = emitPush(c, "rbp"); c = emitMovR64R64(c, "rbp", "rsp")
    c = emitPush(c, "rbx"); c = emitPush(c, "r12"); c = emitPush(c, "r13")
    c = emitPush(c, "r14"); c = emitPush(c, "r15")
    // rbx = cmd pointer
    c = emitMovR64R64(c, "rbx", "rdi")
    // Build argv array: [sh, -c, cmd, NULL] -- 4 pointers (32 bytes) on stack
    c = emitSubR64Imm8(c, "rsp", 32)
    c = emitMovR64R64(c, "r12", "rsp")
    // argv[0] = "/bin/sh"
    c = emitLeaR64Label(c, "rax", "__ae_sh_path")
    c = emitMovR64ToAddr(c, "rax", "r12", 0)
    // argv[1] = "-c"
    c = emitLeaR64Label(c, "rax", "__ae_sh_c")
    c = emitMovR64ToAddr(c, "rax", "r12", 8)
    // argv[2] = cmd
    c = emitMovR64ToAddr(c, "rbx", "r12", 16)
    // argv[3] = NULL
    c = emitXorR64R64(c, "rax", "rax")
    c = emitMovR64ToAddr(c, "rax", "r12", 24)
    // envp = pointer to empty array [NULL] (macOS execve rejects NULL envp)
    c = emitSubR64Imm8(c, "rsp", 8)
    c = emitMovR64R64(c, "rdi", "rsp")
    c = emitXorR64R64(c, "rax", "rax")
    c = emitMovR64ToAddr(c, "rax", "rdi", 0)
    c = emitMovR64R64(c, "r13", "rdi")
    // fork()
    c = emitMovR64Imm64(c, "rax", 0x2000002)
    c = emitSyscall(c)
    c = emitTestR64R64(c, "rax", "rax")
    c = emitJnsLabel(c, "__ae_system_fork_ok")
    // fork failed: return -1 (rax = 0 - 1)
    c = emitXorR64R64(c, "rax", "rax")
    c = emitSubR64Imm8(c, "rax", 1)
    c = emitAddR64Imm8(c, "rsp", 8)   // free envp slot
    c = emitAddR64Imm8(c, "rsp", 32)  // free argv array
    c = emitPop(c, "r15"); c = emitPop(c, "r14"); c = emitPop(c, "r13")
    c = emitPop(c, "r12"); c = emitPop(c, "rbx"); c = emitPop(c, "rbp")
    c = emitRet(c)
    // Child path
    c = label(c, "__ae_system_fork_ok")
    c = emitMovR64R64(c, "r14", "rax")
    c = emitTestR64R64(c, "rax", "rax")
    c = emitJnzLabel(c, "__ae_system_parent")
    // Child: execve("/bin/sh", argv, envp)
    c = emitLeaR64Label(c, "rdi", "__ae_sh_path")
    c = emitMovR64R64(c, "rsi", "r12")
    c = emitMovR64R64(c, "rdx", "r13")
    c = emitMovR64Imm64(c, "rax", 0x200003B)
    c = emitSyscall(c)
    // execve failed: _exit(127)
    c = emitMovR64Imm64(c, "rdi", 127)
    c = emitMovR64Imm64(c, "rax", 0x2000001)
    c = emitSyscall(c)
    // Parent: wait4(pid, &status, 0, NULL)
    c = label(c, "__ae_system_parent")
    c = emitSubR64Imm8(c, "rsp", 8)
    c = emitMovR64R64(c, "r15", "rsp")
    c = emitMovR64R64(c, "rdi", "r14")
    c = emitMovR64R64(c, "rsi", "r15")
    c = emitXorR64R64(c, "rdx", "rdx")
    c = emitXorR64R64(c, "rcx", "rcx")
    c = emitMovR64Imm64(c, "rax", 0x2000007)
    c = emitSyscall(c)
    c = emitAddR64Imm8(c, "rsp", 8)   // free status slot
    c = emitAddR64Imm8(c, "rsp", 8)   // free envp slot
    c = emitAddR64Imm8(c, "rsp", 32)  // free argv array
    c = emitPop(c, "r15"); c = emitPop(c, "r14"); c = emitPop(c, "r13")
    c = emitPop(c, "r12"); c = emitPop(c, "rbx"); c = emitPop(c, "rbp")
    c = emitRet(c)
    return c
}

func emitAeWriteFile(c: codegen): codegen {
    // __ae_write_file(path: string, data: [byte], len: u64): u64
    // rdi = path (null-terminated string), rsi = array header ptr, rdx = element count
    // Array header: [0]=tag, [8]=len, [16]=cap, [24]=data_ptr (8-byte slots)
    // Must pack 8-byte slots into contiguous bytes before write syscall.
    c = label(c, "__ae_write_file")
    c = emitPush(c, "rbp"); c = emitMovR64R64(c, "rbp", "rsp")
    c = emitPush(c, "rbx"); c = emitPush(c, "r12"); c = emitPush(c, "r13")
    c = emitPush(c, "r14"); c = emitPush(c, "r15")
    // rbx = path, r12 = array header, r13 = element count
    c = emitMovR64R64(c, "rbx", "rdi"); c = emitMovR64R64(c, "r12", "rsi"); c = emitMovR64R64(c, "r13", "rdx")
    // Open file: open(path, O_WRONLY|O_CREAT|O_TRUNC, 0644)
    c = emitMovR64R64(c, "rdi", "rbx")
    c = emitMovR64Imm64(c, "rsi", 0x601); c = emitMovR64Imm64(c, "rdx", 0x1A4)
    c = emitMovR64Imm64(c, "rax", 0x2000005); c = emitSyscall(c)
    c = emitTestR64R64(c, "rax", "rax"); c = emitJnsLabel(c, "__ae_write_open_ok")
    c = emitMovR64Imm64(c, "rax", 1)
    c = emitPop(c, "r15"); c = emitPop(c, "r14"); c = emitPop(c, "r13")
    c = emitPop(c, "r12"); c = emitPop(c, "rbx")
    c = emitPop(c, "rbp"); c = emitRet(c)
    c = label(c, "__ae_write_open_ok")
    // r14 = fd, r15 = array data ptr = [r12+24]
    c = emitMovR64R64(c, "r14", "rax")
    c = emitMovFromAddr(c, "r15", "r12", 24)
    // Allocate contiguous buffer via mmap (avoids label refs that linkMachO can't patch):
    // mmap(NULL, r13, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANON, -1, 0)
    // rdi = 0 (addr = NULL), rsi = r13 (size), rdx = 3 (PROT_READ|PROT_WRITE)
    // r10 = 0x1002 (MAP_PRIVATE|MAP_ANON), r8 = -1 (fd), r9 = 0 (offset)
    c = emitXorR64R64(c, "rdi", "rdi")  // addr = NULL
    c = emitMovR64R64(c, "rsi", "r13")   // size = element count
    c = emitMovR64Imm64(c, "rdx", 3)     // PROT_READ|PROT_WRITE
    c = emitMovR64Imm64(c, "r10", 0x1002) // MAP_PRIVATE|MAP_ANON
    // fd = -1: use xor + sub 1 instead of movabs (avoids 0xFFFFFFFFFFFFFFFF literal parse error)
    c = emitXorR64R64(c, "r8", "r8"); c = emitSubR64Imm8(c, "r8", 1)
    c = emitXorR64R64(c, "r9", "r9")     // offset = 0
    c = emitMovR64Imm64(c, "rax", 0x20000C5) // sys_mmap
    c = emitSyscall(c)
    // rbx = mmap result (contiguous buffer)
    c = emitMovR64R64(c, "rbx", "rax")
    // Pack loop: for i in 0..r13: buf[i] = byte(data[i]) where data[i] = [r15 + i*8]
    c = emitXorR64R64(c, "rcx", "rcx")  // i = 0
    c = label(c, "__ae_write_pack_loop")
    c = emitCmpR64R64(c, "rcx", "r13")
    c = emitJzLabel(c, "__ae_write_pack_done")
    // rax = i * 8 (offset into 8-byte slot array)
    c = emitMovR64R64(c, "rax", "rcx")
    c = emitShlR64Imm8(c, "rax", 3)
    c = emitAddR64R64(c, "rax", "r15")  // rax = &data[i]
    c = emitMovFromAddr(c, "rax", "rax", 0)  // rax = data[i] (8-byte slot)
    // buf[i] = al (low byte)
    c = emitMovR64R64(c, "rdx", "rbx")
    c = emitAddR64R64(c, "rdx", "rcx")  // rdx = &buf[i]
    c = emitByte(c, 0x88); c = emitByte(c, 0x02)  // mov byte [rdx], al
    c = emitAddR64Imm8(c, "rcx", 1)
    c = emitJmpLabel(c, "__ae_write_pack_loop")
    c = label(c, "__ae_write_pack_done")
    // Write: write(fd, buf, len)
    c = emitMovR64R64(c, "rdi", "r14")  // fd
    c = emitMovR64R64(c, "rsi", "rbx")  // packed buffer
    c = emitMovR64R64(c, "rdx", "r13")  // byte count
    c = emitMovR64Imm64(c, "rax", 0x2000004); c = emitSyscall(c)
    // Close: close(fd)
    c = emitMovR64R64(c, "rdi", "r14")
    c = emitMovR64Imm64(c, "rax", 0x2000006); c = emitSyscall(c)
    c = emitXorR64R64(c, "rax", "rax")
    c = emitPop(c, "r15"); c = emitPop(c, "r14"); c = emitPop(c, "r13")
    c = emitPop(c, "r12"); c = emitPop(c, "rbx")
    c = emitPop(c, "rbp"); c = emitRet(c)
    return c
}

func emitAeReadFile(c: codegen): codegen {
    c = label(c, "__ae_read_file")
    c = emitPush(c, "rbp"); c = emitMovR64R64(c, "rbp", "rsp")
    c = emitPush(c, "rbx"); c = emitPush(c, "r12")
    c = emitMovR64R64(c, "rbx", "rdi")
    c = emitMovR64R64(c, "rdi", "rbx")
    c = emitXorR64R64(c, "rsi", "rsi"); c = emitXorR64R64(c, "rdx", "rdx")
    c = emitMovR64Imm64(c, "rax", 0x2000005); c = emitSyscall(c)
    c = emitTestR64R64(c, "rax", "rax"); c = emitJnsLabel(c, "__ae_read_open_ok")
    c = emitLeaR64Label(c, "rax", "__ae_empty_str")
    c = emitPop(c, "r12"); c = emitPop(c, "rbx"); c = emitPop(c, "rbp"); c = emitRet(c)
    c = label(c, "__ae_read_open_ok")
    c = emitMovR64R64(c, "r12", "rax")
    c = emitMovR64R64(c, "rdi", "r12")
    c = emitLeaR64Label(c, "rsi", "__ae_read_buf")
    c = emitMovR64Imm64(c, "rdx", 4096)
    c = emitMovR64Imm64(c, "rax", 0x2000003); c = emitSyscall(c)
    c = emitTestR64R64(c, "rax", "rax"); c = emitJnsLabel(c, "__ae_read_ok")
    c = emitMovR64R64(c, "rdi", "r12")
    c = emitMovR64Imm64(c, "rax", 0x2000006); c = emitSyscall(c)
    c = emitLeaR64Label(c, "rax", "__ae_empty_str")
    c = emitPop(c, "r12"); c = emitPop(c, "rbx"); c = emitPop(c, "rbp"); c = emitRet(c)
    c = label(c, "__ae_read_ok")
    c = emitMovR64R64(c, "rdi", "r12")
    c = emitMovR64Imm64(c, "rax", 0x2000006); c = emitSyscall(c)
    c = emitLeaR64Label(c, "rax", "__ae_read_buf")
    c = emitPop(c, "r12"); c = emitPop(c, "rbx"); c = emitPop(c, "rbp"); c = emitRet(c)
    return c
}

func emitAeGetArg(c: codegen): codegen {
    c = label(c, "__ae_get_arg")
    c = emitPush(c, "rbp"); c = emitMovR64R64(c, "rbp", "rsp")
    c = emitPush(c, "rbx")
    c = emitMovR64R64(c, "rbx", "rdi")
    // Load argc from global
    c = emitLeaR64Label(c, "rcx", "__ae_saved_argc")
    c = emitMovFromAddr(c, "rdx", "rcx", 0)  // rdx = argc
    c = emitCmpR64R64(c, "rbx", "rdx")
    c = emitJbLabel(c, "__ae_get_arg_ok")
    c = emitLeaR64Label(c, "rax", "__ae_empty_str")
    c = emitPop(c, "rbx"); c = emitPop(c, "rbp"); c = emitRet(c)
    c = label(c, "__ae_get_arg_ok")
    // Load argv from global
    c = emitLeaR64Label(c, "rcx", "__ae_saved_argv")
    c = emitMovFromAddr(c, "rcx", "rcx", 0)  // rcx = argv
    c = emitMovR64R64(c, "rax", "rbx")
    c = emitShlR64Imm8(c, "rax", 3)
    c = emitAddR64R64(c, "rax", "rcx")
    c = emitMovFromAddr(c, "rax", "rax", 0)
    c = emitPop(c, "rbx"); c = emitPop(c, "rbp"); c = emitRet(c)
    return c
}

func emitAeArgc(c: codegen): codegen {
    c = label(c, "__ae_argc")
    c = emitPush(c, "rbp"); c = emitMovR64R64(c, "rbp", "rsp")
    // Load argc from global
    c = emitLeaR64Label(c, "rcx", "__ae_saved_argc")
    c = emitMovFromAddr(c, "rax", "rcx", 0)
    c = emitPop(c, "rbp"); c = emitRet(c)
    return c
}

func emitAeLen(c: codegen): codegen {
    c = label(c, "__ae_len")
    c = emitPush(c, "rbp"); c = emitMovR64R64(c, "rbp", "rsp")
    c = emitPush(c, "rdi"); c = emitPush(c, "rsi")
    // Check tag: if [rdi] == AE_ARRAY_TAG, it's an array -> return [rdi+8]
    c = emitMovFromAddr(c, "rax", "rdi", 0)
    c = emitMovR64Imm64(c, "rcx", 0x7E41AE41AE41AE41)
    c = emitCmpR64R64(c, "rax", "rcx")
    c = emitJnzLabel(c, "__ae_len_string")
    c = emitMovFromAddr(c, "rax", "rdi", 8)
    c = emitJmpLabel(c, "__ae_len_done")
    // String: scan for null terminator
    c = label(c, "__ae_len_string")
    c = emitMovR64R64(c, "rsi", "rdi"); c = emitXorR64R64(c, "rax", "rax")
    c = label(c, "__ae_len_loop")
    c = emitByte(c, 0x80); c = emitByte(c, 0x3C); c = emitByte(c, 0x06); c = emitByte(c, 0x00)
    c = emitJzLabel(c, "__ae_len_done")
    c = emitAddR64Imm8(c, "rax", 1)
    c = emitJmpLabel(c, "__ae_len_loop")
    c = label(c, "__ae_len_done")
    c = emitPop(c, "rsi"); c = emitPop(c, "rdi"); c = emitPop(c, "rbp"); c = emitRet(c)
    return c
}

// __ae_slice: slice a string OR array.
// rdi = pointer, rsi = start, rdx = end. Returns heap copy in rax.
func emitAeSlice(c: codegen): codegen {
    c = label(c, "__ae_slice")
    c = emitPush(c, "rbp"); c = emitMovR64R64(c, "rbp", "rsp")
    c = emitPush(c, "rdi"); c = emitPush(c, "rsi"); c = emitPush(c, "rdx")
    c = emitPush(c, "rbx"); c = emitPush(c, "r12"); c = emitPush(c, "r13")
    c = emitPush(c, "r14"); c = emitPush(c, "r15")
    c = emitMovR64R64(c, "rbx", "rdi")   // object
    c = emitMovR64R64(c, "r12", "rsi")   // start
    c = emitMovR64R64(c, "r13", "rdx")   // end
    c = emitMovR64R64(c, "r14", "r13")   // len = end - start
    c = emitSubR64R64(c, "r14", "r12")
    // Check tag: array?
    c = emitMovFromAddr(c, "rax", "rbx", 0)
    c = emitMovR64Imm64(c, "rcx", 0x7E41AE41AE41AE41)
    c = emitCmpR64R64(c, "rax", "rcx")
    c = emitJnzLabel(c, "__ae_slice_string")
    // ---- Array path ----
    c = emitMovR64Imm64(c, "rdi", 32)
    c = emitCallLabel(c, "__ae_alloc")
    c = emitMovR64R64(c, "r15", "rax")   // new header
    c = emitMovR64Imm64(c, "rcx", 0x7E41AE41AE41AE41)
    c = emitMovR64ToAddr(c, "rcx", "r15", 0)
    c = emitMovR64ToAddr(c, "r14", "r15", 8)
    c = emitMovR64ToAddr(c, "r14", "r15", 16)
    c = emitMovR64R64(c, "rdi", "r14")
    c = emitShlR64Imm8(c, "rdi", 3)
    c = emitCallLabel(c, "__ae_alloc")
    c = emitMovR64ToAddr(c, "rax", "r15", 24)
    c = emitMovFromAddr(c, "rcx", "rbx", 24)  // src data
    c = emitXorR64R64(c, "r8", "r8")
    c = label(c, "__ae_slice_arr_loop")
    c = emitCmpR64R64(c, "r8", "r14")
    c = emitJzLabel(c, "__ae_slice_arr_done")
    c = emitMovR64R64(c, "r9", "r12")
    c = emitAddR64R64(c, "r9", "r8")
    c = emitShlR64Imm8(c, "r9", 3)
    c = emitAddR64R64(c, "r9", "rcx")
    c = emitMovFromAddr(c, "r9", "r9", 0)
    c = emitMovR64R64(c, "r10", "r8")
    c = emitShlR64Imm8(c, "r10", 3)
    c = emitAddR64R64(c, "r10", "rax")
    c = emitMovR64ToAddr(c, "r9", "r10", 0)
    c = emitAddR64Imm8(c, "r8", 1)
    c = emitJmpLabel(c, "__ae_slice_arr_loop")
    c = label(c, "__ae_slice_arr_done")
    c = emitMovR64R64(c, "rax", "r15")
    c = emitJmpLabel(c, "__ae_slice_done")
    // ---- String path ----
    c = label(c, "__ae_slice_string")
    c = emitMovR64R64(c, "rdi", "r14")
    c = emitAddR64Imm8(c, "rdi", 1)
    c = emitCallLabel(c, "__ae_alloc")
    c = emitXorR64R64(c, "r8", "r8")
    c = label(c, "__ae_slice_str_loop")
    c = emitCmpR64R64(c, "r8", "r14")
    c = emitJzLabel(c, "__ae_slice_str_done")
    c = emitMovR64R64(c, "r9", "r12")
    c = emitAddR64R64(c, "r9", "r8")
    c = emitAddR64R64(c, "r9", "rbx")
    c = emitByte(c, 0x41); c = emitByte(c, 0x8A); c = emitByte(c, 0x09)  // mov cl, byte [r9]
    c = emitMovR64R64(c, "r10", "rax")
    c = emitAddR64R64(c, "r10", "r8")
    c = emitByte(c, 0x41); c = emitByte(c, 0x88); c = emitByte(c, 0x0A)  // mov byte [r10], cl
    c = emitAddR64Imm8(c, "r8", 1)
    c = emitJmpLabel(c, "__ae_slice_str_loop")
    c = label(c, "__ae_slice_str_done")
    c = emitMovR64R64(c, "rcx", "rax")
    c = emitAddR64R64(c, "rcx", "r14")
    c = emitXorR64R64(c, "rdx", "rdx")
    c = emitByte(c, 0x88); c = emitByte(c, 0x11)  // mov byte [rcx], dl
    c = label(c, "__ae_slice_done")
    c = emitPop(c, "r15"); c = emitPop(c, "r14"); c = emitPop(c, "r13")
    c = emitPop(c, "r12"); c = emitPop(c, "rbx"); c = emitPop(c, "rdx")
    c = emitPop(c, "rsi"); c = emitPop(c, "rdi"); c = emitPop(c, "rbp"); c = emitRet(c)
    return c
}

func emitAeIndex(c: codegen): codegen {
    c = label(c, "__ae_index")
    c = emitPush(c, "rbp"); c = emitMovR64R64(c, "rbp", "rsp")
    c = emitPush(c, "rdi"); c = emitPush(c, "rsi"); c = emitPush(c, "rbx")
    // Check tag: if [rdi] == AE_ARRAY_TAG, it's an array
    c = emitMovFromAddr(c, "rax", "rdi", 0)
    c = emitMovR64Imm64(c, "rcx", 0x7E41AE41AE41AE41)
    c = emitCmpR64R64(c, "rax", "rcx")
    c = emitJnzLabel(c, "__ae_index_string")
    // Array: rax = [[rdi+24] + rsi*8]
    c = emitMovFromAddr(c, "rbx", "rdi", 24)
    c = emitMovR64R64(c, "rax", "rsi")
    c = emitShlR64Imm8(c, "rax", 3)
    c = emitAddR64R64(c, "rax", "rbx")
    c = emitMovFromAddr(c, "rax", "rax", 0)
    c = emitJmpLabel(c, "__ae_index_done")
    // String: movzx rax, byte [rdi + rsi]
    c = label(c, "__ae_index_string")
    c = emitAddR64R64(c, "rdi", "rsi")
    c = emitRexW(c); c = emitByte(c, 0x0F); c = emitByte(c, 0xB6); c = emitByte(c, 0x07)
    c = label(c, "__ae_index_done")
    c = emitPop(c, "rbx"); c = emitPop(c, "rsi"); c = emitPop(c, "rdi"); c = emitPop(c, "rbp"); c = emitRet(c)
    return c
}

func emitAeIndexSet(c: codegen): codegen {
    c = label(c, "__ae_index_set")
    c = emitPush(c, "rbp"); c = emitMovR64R64(c, "rbp", "rsp")
    c = emitPush(c, "rdi"); c = emitPush(c, "rsi"); c = emitPush(c, "rbx")
    // Check tag: if [rdi] == AE_ARRAY_TAG, it's an array
    c = emitMovFromAddr(c, "rax", "rdi", 0)
    c = emitMovR64Imm64(c, "rcx", 0x7E41AE41AE41AE41)
    c = emitCmpR64R64(c, "rax", "rcx")
    c = emitJnzLabel(c, "__ae_index_set_string")
    // Array: [ [rdi+24] + rsi*8 ] = rdx  (8-byte store)
    c = emitMovFromAddr(c, "rbx", "rdi", 24)
    c = emitMovR64R64(c, "rax", "rsi")
    c = emitShlR64Imm8(c, "rax", 3)
    c = emitAddR64R64(c, "rax", "rbx")
    c = emitMovR64ToAddr(c, "rdx", "rax", 0)
    c = emitJmpLabel(c, "__ae_index_set_done")
    // String: [rdi + rsi] = dl  (byte store)
    c = label(c, "__ae_index_set_string")
    c = emitAddR64R64(c, "rdi", "rsi")
    c = emitByte(c, 0x88); c = emitByte(c, 0x17)
    c = label(c, "__ae_index_set_done")
    c = emitPop(c, "rbx"); c = emitPop(c, "rsi"); c = emitPop(c, "rdi"); c = emitPop(c, "rbp"); c = emitRet(c)
    return c
}

func emitAeAlloc(c: codegen): codegen {
    c = label(c, "__ae_alloc")
    c = emitPush(c, "rbp"); c = emitMovR64R64(c, "rbp", "rsp")
    c = emitPush(c, "rdi"); c = emitPush(c, "rbx")
    c = emitLeaR64Label(c, "rcx", "__ae_heap_ptr")
    c = emitMovFromAddr(c, "rbx", "rcx", 0)  // rbx = heap ptr
    c = emitMovR64R64(c, "rax", "rbx")       // return value
    c = emitAddR64R64(c, "rbx", "rdi")       // advance by size
    c = emitLeaR64Label(c, "rcx", "__ae_heap_ptr")
    c = emitMovR64ToAddr(c, "rbx", "rcx", 0) // [heap_ptr] = rbx
    c = emitPop(c, "rbx"); c = emitPop(c, "rdi"); c = emitPop(c, "rbp"); c = emitRet(c)
    return c
}

func emitAeArrayNew(c: codegen): codegen {
    c = label(c, "__ae_array_new")
    c = emitPush(c, "rbp"); c = emitMovR64R64(c, "rbp", "rsp")
    c = emitPush(c, "rdi"); c = emitPush(c, "rsi"); c = emitPush(c, "rbx"); c = emitPush(c, "r12")
    // rbx = current heap ptr
    c = emitLeaR64Label(c, "rcx", "__ae_heap_ptr")
    c = emitMovFromAddr(c, "rbx", "rcx", 0)
    // rax = header = rbx (return value)
    c = emitMovR64R64(c, "rax", "rbx")
    // Set tag at [rbx+0]
    c = emitMovR64Imm64(c, "rcx", 0x7E41AE41AE41AE41)
    c = emitMovR64ToAddr(c, "rcx", "rbx", 0)
    // Set len at [rbx+8] = n (rdi)
    c = emitMovR64ToAddr(c, "rdi", "rbx", 8)
    // Set cap at [rbx+16] = n (rdi)
    c = emitMovR64ToAddr(c, "rdi", "rbx", 16)
    // data ptr at [rbx+24] = rbx + 32
    c = emitMovR64R64(c, "r12", "rbx")
    c = emitAddR64Imm8(c, "r12", 32)
    c = emitMovR64ToAddr(c, "r12", "rbx", 24)
    // Advance heap ptr: [__ae_heap_ptr] = rbx + 32 + n*8
    c = emitMovR64R64(c, "r12", "rdi")
    c = emitShlR64Imm8(c, "r12", 3)
    c = emitAddR64Imm8(c, "r12", 32)
    c = emitAddR64R64(c, "r12", "rbx")
    c = emitLeaR64Label(c, "rcx", "__ae_heap_ptr")
    c = emitMovR64ToAddr(c, "r12", "rcx", 0)
    c = emitPop(c, "r12"); c = emitPop(c, "rbx"); c = emitPop(c, "rsi"); c = emitPop(c, "rdi"); c = emitPop(c, "rbp"); c = emitRet(c)
    return c
}

func emitAeStrConcat(c: codegen): codegen {
    c = label(c, "__ae_str_concat")
    c = emitPush(c, "rbp"); c = emitMovR64R64(c, "rbp", "rsp")
    c = emitPop(c, "rbp"); c = emitRet(c)
    return c
}

func emitAeStrEq(c: codegen): codegen {
    c = label(c, "__ae_str_eq")
    c = emitPush(c, "rbp"); c = emitMovR64R64(c, "rbp", "rsp")
    c = emitPush(c, "rbx"); c = emitPush(c, "r12"); c = emitPush(c, "rcx")
    c = emitMovR64R64(c, "rbx", "rdi"); c = emitMovR64R64(c, "r12", "rsi")
    c = label(c, "__ae_str_eq_loop")
    c = emitXorR64R64(c, "rax", "rax")
    c = emitByte(c, 0x8A); c = emitByte(c, 0x03)                    // mov al, byte [rbx]
    c = emitXorR64R64(c, "rcx", "rcx")
    c = emitByte(c, 0x41); c = emitByte(c, 0x8A); c = emitByte(c, 0x0C); c = emitByte(c, 0x24)  // mov cl, byte [r12]
    c = emitByte(c, 0x38); c = emitByte(c, 0xC8)                    // cmp al, cl
    c = emitJnzLabel(c, "__ae_str_eq_done")
    c = emitTestR64R64(c, "rax", "rax")
    c = emitJzLabel(c, "__ae_str_eq_done")
    c = emitAddR64Imm8(c, "rbx", 1); c = emitAddR64Imm8(c, "r12", 1)
    c = emitJmpLabel(c, "__ae_str_eq_loop")
    c = label(c, "__ae_str_eq_done")
    c = emitSete(c, "al"); c = emitMovzxR64R8(c, "rax", "al")
    c = emitPop(c, "rcx"); c = emitPop(c, "r12"); c = emitPop(c, "rbx"); c = emitPop(c, "rbp"); c = emitRet(c)
    return c
}

func emitAePush(c: codegen): codegen {
    c = label(c, "__ae_push")
    c = emitPush(c, "rbp"); c = emitMovR64R64(c, "rbp", "rsp")
    c = emitPush(c, "rdi"); c = emitPush(c, "rsi"); c = emitPush(c, "rbx")
    c = emitPush(c, "r12"); c = emitPush(c, "r13")
    // rbx = array header pointer
    c = emitMovR64R64(c, "rbx", "rdi")
    // r12 = value
    c = emitMovR64R64(c, "r12", "rsi")
    // rax = len = [rbx+8]
    c = emitMovFromAddr(c, "rax", "rbx", 8)
    // rcx = cap = [rbx+16]
    c = emitMovFromAddr(c, "rcx", "rbx", 16)
    // if len < cap: fast path (no realloc)
    c = emitCmpR64R64(c, "rax", "rcx")
    c = emitJbLabel(c, "__ae_push_fast")
    // ---- Grow path ----
    // newCap = cap * 2 (or cap+1 if cap==0)
    c = emitMovR64R64(c, "r13", "rcx")
    c = emitTestR64R64(c, "r13", "r13")
    c = emitJnzLabel(c, "__ae_push_grow_double")
    c = emitMovR64Imm64(c, "r13", 1)
    c = emitJmpLabel(c, "__ae_push_grow_alloc")
    c = label(c, "__ae_push_grow_double")
    c = emitShlR64Imm8(c, "r13", 1)
    // Allocate new data buffer: newCap*8 bytes from heap
    c = label(c, "__ae_push_grow_alloc")
    c = emitLeaR64Label(c, "rcx", "__ae_heap_ptr")
    c = emitMovFromAddr(c, "rcx", "rcx", 0)
    c = emitMovR64R64(c, "rdx", "r13")
    c = emitShlR64Imm8(c, "rdx", 3)
    c = emitAddR64R64(c, "rcx", "rdx")
    c = emitLeaR64Label(c, "rdx", "__ae_heap_ptr")
    c = emitMovR64ToAddr(c, "rcx", "rdx", 0)
    // Copy old data (len elements) to new buffer
    c = emitMovFromAddr(c, "rcx", "rbx", 24)
    c = emitLeaR64Label(c, "rdx", "__ae_heap_ptr")
    c = emitMovFromAddr(c, "rdx", "rdx", 0)
    c = emitMovR64R64(c, "r8", "r13")
    c = emitShlR64Imm8(c, "r8", 3)
    c = emitSubR64R64(c, "rdx", "r8")
    // Copy loop: for i in 0..len: [rdx + i*8] = [rcx + i*8]
    c = emitXorR64R64(c, "r8", "r8")
    c = label(c, "__ae_push_copy_loop")
    c = emitCmpR64R64(c, "r8", "rax")
    c = emitJzLabel(c, "__ae_push_copy_done")
    c = emitMovFromAddr(c, "r9", "rcx", 0)
    c = emitMovR64R64(c, "r10", "r8")
    c = emitShlR64Imm8(c, "r10", 3)
    c = emitAddR64R64(c, "r10", "rdx")
    c = emitMovR64ToAddr(c, "r9", "r10", 0)
    c = emitAddR64Imm8(c, "rcx", 8)
    c = emitAddR64Imm8(c, "r8", 1)
    c = emitJmpLabel(c, "__ae_push_copy_loop")
    c = label(c, "__ae_push_copy_done")
    // Update header: data = newData, cap = newCap
    c = emitLeaR64Label(c, "r8", "__ae_heap_ptr")
    c = emitMovFromAddr(c, "r8", "r8", 0)
    c = emitMovR64R64(c, "r9", "r13")
    c = emitShlR64Imm8(c, "r9", 3)
    c = emitSubR64R64(c, "r8", "r9")
    c = emitMovR64ToAddr(c, "r8", "rbx", 24)
    c = emitMovR64ToAddr(c, "r13", "rbx", 16)
    // ---- Fast path ----
    c = label(c, "__ae_push_fast")
    c = emitMovFromAddr(c, "rax", "rbx", 8)
    c = emitMovFromAddr(c, "rcx", "rbx", 24)
    c = emitMovR64R64(c, "rdx", "rax")
    c = emitShlR64Imm8(c, "rdx", 3)
    c = emitAddR64R64(c, "rdx", "rcx")
    c = emitMovR64ToAddr(c, "r12", "rdx", 0)
    c = emitAddR64Imm8(c, "rax", 1)
    c = emitMovR64ToAddr(c, "rax", "rbx", 8)
    // Return array pointer
    c = emitMovR64R64(c, "rax", "rbx")
    c = emitPop(c, "r13"); c = emitPop(c, "r12"); c = emitPop(c, "rbx")
    c = emitPop(c, "rsi"); c = emitPop(c, "rdi"); c = emitPop(c, "rbp"); c = emitRet(c)
    return c
}

func emitAePop(c: codegen): codegen {
    c = label(c, "__ae_pop")
    c = emitPush(c, "rbp"); c = emitMovR64R64(c, "rbp", "rsp")
    c = emitPush(c, "rdi"); c = emitPush(c, "rbx")
    // rbx = array header
    c = emitMovR64R64(c, "rbx", "rdi")
    // rax = len = [rbx+8]
    c = emitMovFromAddr(c, "rax", "rbx", 8)
    // if len == 0, return 0
    c = emitTestR64R64(c, "rax", "rax")
    c = emitJzLabel(c, "__ae_pop_done")
    // len--
    c = emitSubR64Imm8(c, "rax", 1)
    c = emitMovR64ToAddr(c, "rax", "rbx", 8)
    // rcx = data = [rbx+24]
    c = emitMovFromAddr(c, "rcx", "rbx", 24)
    // rax = [data + (len-1)*8]
    c = emitMovR64R64(c, "rdx", "rax")
    c = emitShlR64Imm8(c, "rdx", 3)
    c = emitAddR64R64(c, "rdx", "rcx")
    c = emitMovFromAddr(c, "rax", "rdx", 0)
    c = label(c, "__ae_pop_done")
    c = emitPop(c, "rbx"); c = emitPop(c, "rdi"); c = emitPop(c, "rbp"); c = emitRet(c)
    return c
}

func emitPushBuiltin(c: codegen): codegen {
    c = label(c, "push")
    c = emitPush(c, "rbp"); c = emitMovR64R64(c, "rbp", "rsp")
    c = emitCallLabel(c, "__ae_push")
    c = emitPop(c, "rbp"); c = emitRet(c)
    return c
}

func emitLogicalHelpers(c: codegen): codegen {
    c = label(c, "_logical_true")
    c = emitMovR64Imm64(c, "rax", 1); c = emitRet(c)
    c = label(c, "_logical_false")
    c = emitXorR64R64(c, "rax", "rax"); c = emitRet(c)
    return c
}

// emitStructFieldHelpers emits __ae_field_<Struct>_<name> and __ae_field_set_<Struct>_<name>
// helpers for every (Struct, field) pair discovered during skipStructDecl.
// Each getter takes a struct pointer in rdi and returns the field value in rax.
// Each setter takes a struct pointer in rdi and value in rsi.
func emitStructFieldHelpers(c: codegen): codegen {
    var i: u64 = 0
    while i < #c.structFields {
        let key = c.structFields[i]
        let offset: u64 = c.structFieldOffsets[i]
        // key = "StructName.fieldName"
        var dotIdx: u64 = 0
        var foundDot: bool = false
        var j: u64 = 0
        while j < #key {
            if key[j] == 46 and not foundDot {  // 46 == '.'
                dotIdx = j
                foundDot = true
            }
            j = j + 1
        }
        var structName: string = ""
        var fieldName: string = ""
        if foundDot {
            structName = key[0:dotIdx]
            fieldName = key[dotIdx+1:#key]
        } else {
            fieldName = key
        }
        let getterLabel = "__ae_field_" + structName + "_" + fieldName
        let setterLabel = "__ae_field_set_" + structName + "_" + fieldName

        // Getter: __ae_field_<Struct>_<name>
        c = label(c, getterLabel)
        c = emitPush(c, "rbp")
        c = emitMovR64R64(c, "rbp", "rsp")
        // Load field at offset from struct pointer (rdi)
        c = emitMovFromAddr(c, "rax", "rdi", offset)
        c = emitPop(c, "rbp")
        c = emitRet(c)

        // Setter: __ae_field_set_<Struct>_<name>
        c = label(c, setterLabel)
        c = emitPush(c, "rbp")
        c = emitMovR64R64(c, "rbp", "rsp")
        // Store value (rsi) at field offset of struct pointer (rdi)
        c = emitMovR64ToAddr(c, "rsi", "rdi", offset)
        c = emitPop(c, "rbp")
        c = emitRet(c)

        i = i + 1
    }
    return c
}

// ============================================================
// emitMovR64ToAddr / emitMovFromAddr / emitJnsLabel / emitJbLabel / emitShlR64Imm8
// ============================================================

// emitMovR64ToAddr: mov [addrReg + offset], src
// offset is u64; we encode it as a byte disp if it fits, otherwise it's an error.
func emitMovR64ToAddr(c: codegen, src: string, addrReg: string, offset: u64): codegen {
    if offset == 0 {
        c = emitRexWRB(c, regCode(src), regCode(addrReg)); c = emitByte(c, 0x89)
        c = emitByte(c, modRM(0, regCode(src), regCode(addrReg)))
    } else {
        // Mask to byte range. For our use case offsets stay tiny.
        var offByte: u64 = offset & 0xFF
        c = emitRexWRB(c, regCode(src), regCode(addrReg)); c = emitByte(c, 0x89)
        c = emitByte(c, modRM(1, regCode(src), regCode(addrReg)))
        c = emitByte(c, offByte)
    }
    return c
}

// emitMovFromAddr: mov dst, [addrReg + offset]
func emitMovFromAddr(c: codegen, dst: string, addrReg: string, offset: u64): codegen {
    if offset == 0 {
        c = emitRexWRB(c, regCode(dst), regCode(addrReg)); c = emitByte(c, 0x8B)
        c = emitByte(c, modRM(0, regCode(dst), regCode(addrReg)))
    } else {
        var offByte: u64 = offset & 0xFF
        c = emitRexWRB(c, regCode(dst), regCode(addrReg)); c = emitByte(c, 0x8B)
        c = emitByte(c, modRM(1, regCode(dst), regCode(addrReg)))
        c = emitByte(c, offByte)
    }
    return c
}

func emitJnsLabel(c: codegen, labelName: string): codegen {
    c = emitByte(c, 0x0F); c = emitByte(c, 0x89)
    c.labelRefs = push(c.labelRefs, labelName)
    c.labelRefOffsets = push(c.labelRefOffsets, #c.text)
    c.labelRefSizes = push(c.labelRefSizes, 4)
    c = emitU32(c, 0)
    return c
}

func emitJbLabel(c: codegen, labelName: string): codegen {
    c = emitByte(c, 0x0F); c = emitByte(c, 0x82)
    c.labelRefs = push(c.labelRefs, labelName)
    c.labelRefOffsets = push(c.labelRefOffsets, #c.text)
    c.labelRefSizes = push(c.labelRefSizes, 4)
    c = emitU32(c, 0)
    return c
}

func emitShlR64Imm8(c: codegen, reg: string, imm: byte): codegen {
    c = emitRexWRB(c, 0, regCode(reg)); c = emitByte(c, 0xC1)
    c = emitByte(c, modRM(3, 4, regCode(reg)))
    c = emitByte(c, imm)
    return c
}
func align(size: u64, alignment: u64): u64 {
    return (size + alignment - 1) & (0 - alignment)
}

func patchLabelRef(buf: [byte], refOffset: u64, refSize: u64, targetOffset: u64): [byte] {
    let instrEnd = refOffset + refSize
    let disp = targetOffset - instrEnd
    buf[refOffset] = disp & 0xFF
    buf[refOffset + 1] = (disp >> 8) & 0xFF
    buf[refOffset + 2] = (disp >> 16) & 0xFF
    buf[refOffset + 3] = (disp >> 24) & 0xFF
    return buf
}

func findLabelOffset(labels: [string], offsets: [u64], name: string): u64 {
    for i in 0..#labels {
        if labels[i] == name {
            return offsets[i]
        }
    }
    return 0
}

func hasLabel(labels: [string], name: string): bool {
    for i in 0..#labels {
        if labels[i] == name {
            return true
        }
    }
    return false
}
func linkElf(c: codegen): codegen {
    // First, patch all label references in the text buffer
    // We need a mutable copy of text to patch
    var patchedText: [byte] = c.text
    for i in 0..#c.labelRefs {
        let refName = c.labelRefs[i]
        let refOffset = c.labelRefOffsets[i]
        let refSize = c.labelRefSizes[i]
        let targetOffset = findLabelOffset(c.labels, c.labelOffsets, refName)
        if not hasLabel(c.labels, refName) and refName != "" {
            __ae_print(refName)
            __ae_print("]\n")
            c.errors = push(c.errors, "undefined label: " + refName)
        } else {
            patchedText = patchLabelRef(patchedText, refOffset, refSize, targetOffset)
        }
    }

    // Calculate section offsets
    let textOffset: u64 = 0x1000
    let rodataOffset = textOffset + align(#patchedText, 0x1000)
    let dataOffset = rodataOffset + align(#c.rodata, 0x1000)

    // Calculate file offsets
    let textFileOffset: u64 = 0x1000
    let rodataFileOffset = textFileOffset + #patchedText
    let dataFileOffset = rodataFileOffset + #c.rodata

    // Build ELF64 binary
    let headerSize: u64 = 64
    let phdrSize: u64 = 56
    let phdrs: u64 = 3

    let fileSize = headerSize + phdrs * phdrSize + #patchedText + #c.rodata + #c.data
    var buf: [byte] = []
    var offset: u64 = 0

    // Allocate buffer (fill with zeros)
    for i in 0..fileSize {
        buf = push(buf, 0)
    }

    // ELF Header
    // Magic: 0x7f 'E' 'L' 'F'
    buf[0] = 0x7f
    buf[1] = 69  // 'E'
    buf[2] = 76  // 'L'
    buf[3] = 70  // 'F'
    buf[4] = 2   // 64-bit
    buf[5] = 1   // little endian
    buf[6] = 1   // ELF version
    buf[7] = 0   // OS/ABI
    offset = 16

    // e_type = ET_EXEC (2)
    buf[offset] = 2
    buf[offset+1] = 0
    offset = offset + 2

    // e_machine = x86_64 (0x3E)
    buf[offset] = 0x3E
    buf[offset+1] = 0
    offset = offset + 2

    // e_version = 1
    buf[offset] = 1
    buf[offset+1] = 0
    buf[offset+2] = 0
    buf[offset+3] = 0
    offset = offset + 4

    // e_entry = textOffset
    buf[offset] = textOffset & 0xFF
    buf[offset+1] = (textOffset >> 8) & 0xFF
    buf[offset+2] = (textOffset >> 16) & 0xFF
    buf[offset+3] = (textOffset >> 24) & 0xFF
    buf[offset+4] = (textOffset >> 32) & 0xFF
    buf[offset+5] = (textOffset >> 40) & 0xFF
    buf[offset+6] = (textOffset >> 48) & 0xFF
    buf[offset+7] = (textOffset >> 56) & 0xFF
    offset = offset + 8

    // e_phoff = headerSize + phdrs * phdrSize
    let phoff = headerSize + phdrs * phdrSize
    buf[offset] = phoff & 0xFF
    buf[offset+1] = (phoff >> 8) & 0xFF
    buf[offset+2] = (phoff >> 16) & 0xFF
    buf[offset+3] = (phoff >> 24) & 0xFF
    buf[offset+4] = (phoff >> 32) & 0xFF
    buf[offset+5] = (phoff >> 40) & 0xFF
    buf[offset+6] = (phoff >> 48) & 0xFF
    buf[offset+7] = (phoff >> 56) & 0xFF
    offset = offset + 8

    // e_shoff = 0 (no section headers)
    for i in 0..8 {
        buf[offset] = 0
        offset = offset + 1
    }

    // e_flags = 0
    for i in 0..4 {
        buf[offset] = 0
        offset = offset + 1
    }

    // e_ehsize = headerSize
    buf[offset] = headerSize & 0xFF
    buf[offset+1] = (headerSize >> 8) & 0xFF
    offset = offset + 2

    // e_phentsize = phdrSize
    buf[offset] = phdrSize & 0xFF
    buf[offset+1] = (phdrSize >> 8) & 0xFF
    offset = offset + 2

    // e_phnum = phdrs
    buf[offset] = phdrs & 0xFF
    buf[offset+1] = (phdrs >> 8) & 0xFF
    offset = offset + 2

    // e_shentsize = 0
    buf[offset] = 0
    buf[offset+1] = 0
    offset = offset + 2

    // e_shnum = 0
    buf[offset] = 0
    buf[offset+1] = 0
    offset = offset + 2

    // e_shstrndx = 0
    buf[offset] = 0
    buf[offset+1] = 0
    offset = offset + 2

    // Program Header 1: .text (LOAD, RX)
    // p_type = PT_LOAD (1)
    buf[offset] = 1
    buf[offset+1] = 0
    buf[offset+2] = 0
    buf[offset+3] = 0
    offset = offset + 4

    // p_flags = PF_R | PF_W | PF_X (7) -- RWX for runtime data writes
    buf[offset] = 7
    buf[offset+1] = 0
    buf[offset+2] = 0
    buf[offset+3] = 0
    offset = offset + 4

    // p_offset = textFileOffset (file offset where .text data starts)
    buf[offset] = textFileOffset & 0xFF
    buf[offset+1] = (textFileOffset >> 8) & 0xFF
    buf[offset+2] = (textFileOffset >> 16) & 0xFF
    buf[offset+3] = (textFileOffset >> 24) & 0xFF
    buf[offset+4] = (textFileOffset >> 32) & 0xFF
    buf[offset+5] = (textFileOffset >> 40) & 0xFF
    buf[offset+6] = (textFileOffset >> 48) & 0xFF
    buf[offset+7] = (textFileOffset >> 56) & 0xFF
    offset = offset + 8

    // p_vaddr = textOffset
    buf[offset] = textOffset & 0xFF
    buf[offset+1] = (textOffset >> 8) & 0xFF
    buf[offset+2] = (textOffset >> 16) & 0xFF
    buf[offset+3] = (textOffset >> 24) & 0xFF
    buf[offset+4] = (textOffset >> 32) & 0xFF
    buf[offset+5] = (textOffset >> 40) & 0xFF
    buf[offset+6] = (textOffset >> 48) & 0xFF
    buf[offset+7] = (textOffset >> 56) & 0xFF
    offset = offset + 8

    // p_paddr = textOffset
    buf[offset] = textOffset & 0xFF
    buf[offset+1] = (textOffset >> 8) & 0xFF
    buf[offset+2] = (textOffset >> 16) & 0xFF
    buf[offset+3] = (textOffset >> 24) & 0xFF
    buf[offset+4] = (textOffset >> 32) & 0xFF
    buf[offset+5] = (textOffset >> 40) & 0xFF
    buf[offset+6] = (textOffset >> 48) & 0xFF
    buf[offset+7] = (textOffset >> 56) & 0xFF
    offset = offset + 8

    // p_filesz = textFileOffset + len(text)
    let textFileSize = textFileOffset + #patchedText
    buf[offset] = textFileSize & 0xFF
    buf[offset+1] = (textFileSize >> 8) & 0xFF
    buf[offset+2] = (textFileSize >> 16) & 0xFF
    buf[offset+3] = (textFileSize >> 24) & 0xFF
    buf[offset+4] = (textFileSize >> 32) & 0xFF
    buf[offset+5] = (textFileSize >> 40) & 0xFF
    buf[offset+6] = (textFileSize >> 48) & 0xFF
    buf[offset+7] = (textFileSize >> 56) & 0xFF
    offset = offset + 8

    // p_memsz = textFileSize
    buf[offset] = textFileSize & 0xFF
    buf[offset+1] = (textFileSize >> 8) & 0xFF
    buf[offset+2] = (textFileSize >> 16) & 0xFF
    buf[offset+3] = (textFileSize >> 24) & 0xFF
    buf[offset+4] = (textFileSize >> 32) & 0xFF
    buf[offset+5] = (textFileSize >> 40) & 0xFF
    buf[offset+6] = (textFileSize >> 48) & 0xFF
    buf[offset+7] = (textFileSize >> 56) & 0xFF
    offset = offset + 8

    // p_align = 0x1000
    buf[offset] = 0
    buf[offset+1] = 0x10
    buf[offset+2] = 0
    buf[offset+3] = 0
    buf[offset+4] = 0
    buf[offset+5] = 0
    buf[offset+6] = 0
    buf[offset+7] = 0
    offset = offset + 8

    // Program Header 2: .rodata (LOAD, R)
    buf[offset] = 1
    buf[offset+1] = 0
    buf[offset+2] = 0
    buf[offset+3] = 0
    offset = offset + 4

    buf[offset] = 4  // PF_R
    buf[offset+1] = 0
    buf[offset+2] = 0
    buf[offset+3] = 0
    offset = offset + 4

    // p_offset = rodataFileOffset
    buf[offset] = rodataFileOffset & 0xFF
    buf[offset+1] = (rodataFileOffset >> 8) & 0xFF
    buf[offset+2] = (rodataFileOffset >> 16) & 0xFF
    buf[offset+3] = (rodataFileOffset >> 24) & 0xFF
    buf[offset+4] = (rodataFileOffset >> 32) & 0xFF
    buf[offset+5] = (rodataFileOffset >> 40) & 0xFF
    buf[offset+6] = (rodataFileOffset >> 48) & 0xFF
    buf[offset+7] = (rodataFileOffset >> 56) & 0xFF
    offset = offset + 8

    // p_vaddr = rodataOffset
    buf[offset] = rodataOffset & 0xFF
    buf[offset+1] = (rodataOffset >> 8) & 0xFF
    buf[offset+2] = (rodataOffset >> 16) & 0xFF
    buf[offset+3] = (rodataOffset >> 24) & 0xFF
    buf[offset+4] = (rodataOffset >> 32) & 0xFF
    buf[offset+5] = (rodataOffset >> 40) & 0xFF
    buf[offset+6] = (rodataOffset >> 48) & 0xFF
    buf[offset+7] = (rodataOffset >> 56) & 0xFF
    offset = offset + 8

    // p_paddr = rodataOffset
    buf[offset] = rodataOffset & 0xFF
    buf[offset+1] = (rodataOffset >> 8) & 0xFF
    buf[offset+2] = (rodataOffset >> 16) & 0xFF
    buf[offset+3] = (rodataOffset >> 24) & 0xFF
    buf[offset+4] = (rodataOffset >> 32) & 0xFF
    buf[offset+5] = (rodataOffset >> 40) & 0xFF
    buf[offset+6] = (rodataOffset >> 48) & 0xFF
    buf[offset+7] = (rodataOffset >> 56) & 0xFF
    offset = offset + 8

    // p_filesz = len(rodata)
    let rodataLen = #c.rodata
    buf[offset] = rodataLen & 0xFF
    buf[offset+1] = (rodataLen >> 8) & 0xFF
    buf[offset+2] = (rodataLen >> 16) & 0xFF
    buf[offset+3] = (rodataLen >> 24) & 0xFF
    buf[offset+4] = (rodataLen >> 32) & 0xFF
    buf[offset+5] = (rodataLen >> 40) & 0xFF
    buf[offset+6] = (rodataLen >> 48) & 0xFF
    buf[offset+7] = (rodataLen >> 56) & 0xFF
    offset = offset + 8

    // p_memsz = len(rodata)
    buf[offset] = rodataLen & 0xFF
    buf[offset+1] = (rodataLen >> 8) & 0xFF
    buf[offset+2] = (rodataLen >> 16) & 0xFF
    buf[offset+3] = (rodataLen >> 24) & 0xFF
    buf[offset+4] = (rodataLen >> 32) & 0xFF
    buf[offset+5] = (rodataLen >> 40) & 0xFF
    buf[offset+6] = (rodataLen >> 48) & 0xFF
    buf[offset+7] = (rodataLen >> 56) & 0xFF
    offset = offset + 8

    // p_align = 0x1000
    buf[offset] = 0
    buf[offset+1] = 0x10
    buf[offset+2] = 0
    buf[offset+3] = 0
    buf[offset+4] = 0
    buf[offset+5] = 0
    buf[offset+6] = 0
    buf[offset+7] = 0
    offset = offset + 8

    // Program Header 3: .data + .bss (LOAD, RW)
    buf[offset] = 1
    buf[offset+1] = 0
    buf[offset+2] = 0
    buf[offset+3] = 0
    offset = offset + 4

    buf[offset] = 6  // PF_R | PF_W
    buf[offset+1] = 0
    buf[offset+2] = 0
    buf[offset+3] = 0
    offset = offset + 4

    // p_offset = dataFileOffset
    buf[offset] = dataFileOffset & 0xFF
    buf[offset+1] = (dataFileOffset >> 8) & 0xFF
    buf[offset+2] = (dataFileOffset >> 16) & 0xFF
    buf[offset+3] = (dataFileOffset >> 24) & 0xFF
    buf[offset+4] = (dataFileOffset >> 32) & 0xFF
    buf[offset+5] = (dataFileOffset >> 40) & 0xFF
    buf[offset+6] = (dataFileOffset >> 48) & 0xFF
    buf[offset+7] = (dataFileOffset >> 56) & 0xFF
    offset = offset + 8

    // p_vaddr = dataOffset
    buf[offset] = dataOffset & 0xFF
    buf[offset+1] = (dataOffset >> 8) & 0xFF
    buf[offset+2] = (dataOffset >> 16) & 0xFF
    buf[offset+3] = (dataOffset >> 24) & 0xFF
    buf[offset+4] = (dataOffset >> 32) & 0xFF
    buf[offset+5] = (dataOffset >> 40) & 0xFF
    buf[offset+6] = (dataOffset >> 48) & 0xFF
    buf[offset+7] = (dataOffset >> 56) & 0xFF
    offset = offset + 8

    // p_paddr = dataOffset
    buf[offset] = dataOffset & 0xFF
    buf[offset+1] = (dataOffset >> 8) & 0xFF
    buf[offset+2] = (dataOffset >> 16) & 0xFF
    buf[offset+3] = (dataOffset >> 24) & 0xFF
    buf[offset+4] = (dataOffset >> 32) & 0xFF
    buf[offset+5] = (dataOffset >> 40) & 0xFF
    buf[offset+6] = (dataOffset >> 48) & 0xFF
    buf[offset+7] = (dataOffset >> 56) & 0xFF
    offset = offset + 8

    // p_filesz = len(data)
    let dataLen = #c.data
    buf[offset] = dataLen & 0xFF
    buf[offset+1] = (dataLen >> 8) & 0xFF
    buf[offset+2] = (dataLen >> 16) & 0xFF
    buf[offset+3] = (dataLen >> 24) & 0xFF
    buf[offset+4] = (dataLen >> 32) & 0xFF
    buf[offset+5] = (dataLen >> 40) & 0xFF
    buf[offset+6] = (dataLen >> 48) & 0xFF
    buf[offset+7] = (dataLen >> 56) & 0xFF
    offset = offset + 8

    // p_memsz = len(data) + len(bss)
    let dataMemsz = dataLen + #c.bss
    buf[offset] = dataMemsz & 0xFF
    buf[offset+1] = (dataMemsz >> 8) & 0xFF
    buf[offset+2] = (dataMemsz >> 16) & 0xFF
    buf[offset+3] = (dataMemsz >> 24) & 0xFF
    buf[offset+4] = (dataMemsz >> 32) & 0xFF
    buf[offset+5] = (dataMemsz >> 40) & 0xFF
    buf[offset+6] = (dataMemsz >> 48) & 0xFF
    buf[offset+7] = (dataMemsz >> 56) & 0xFF
    offset = offset + 8

    // p_align = 0x1000
    buf[offset] = 0
    buf[offset+1] = 0x10
    buf[offset+2] = 0
    buf[offset+3] = 0
    buf[offset+4] = 0
    buf[offset+5] = 0
    buf[offset+6] = 0
    buf[offset+7] = 0
    offset = offset + 8

    // Write .text at file offset textFileOffset
    for i in 0..#patchedText {
        buf[textFileOffset + i] = patchedText[i]
    }

    // Write .rodata at file offset rodataFileOffset
    for i in 0..#c.rodata {
        buf[rodataFileOffset + i] = c.rodata[i]
    }

    // Write .data at file offset dataFileOffset
    for i in 0..#c.data {
        buf[dataFileOffset + i] = c.data[i]
    }

    c.output = buf
    return c
}

// ============================================================
// Mach-O 64 Linker
// ============================================================

func linkMachO(c: codegen): codegen {
    // Patch all label references in the text buffer using virtual addresses.
    var patchedText: [byte] = c.text
    for i in 0..#c.labelRefs {
        let refName = c.labelRefs[i]
        let refOffset = c.labelRefOffsets[i]
        let refSize = c.labelRefSizes[i]
        let targetOffset = findLabelOffset(c.labels, c.labelOffsets, refName)
        if not hasLabel(c.labels, refName) and refName != "" {
            c.errors = push(c.errors, "undefined label: " + refName)
        } else {
            patchedText = patchLabelRef(patchedText, refOffset, refSize, targetOffset)
        }
    }

    // Combine text + rodata into a single code section.
    var codeSection: [byte] = patchedText
    for i in 0..#c.rodata { codeSection = push(codeSection, c.rodata[i]) }
    // Append data section too (all data lives in __TEXT).
    for i in 0..#c.data { codeSection = push(codeSection, c.data[i]) }

    let codeSize = #codeSection

    // Mach-O layout: header(32) + load_commands(664) + padding + code + __LINKEDIT
    // __TEXT segment fileoff=0 (header is INSIDE __TEXT, required by codesign).
    let ncmds: u64 = 14
    let sizeofcmds: u64 = 664
    let headerSize: u64 = 32
    let codeFileOff = headerSize + sizeofcmds
    // Align code start to 8 bytes
    let codeFileOffAligned = (codeFileOff + 7) / 8 * 8

    // Page-align text vmsize (Mach-O requires segment vmsize page-aligned).
    let textVmsize = ((codeFileOffAligned + codeSize + 0xFFF) / 0x1000) * 0x1000
    let textFilesize = codeFileOffAligned + codeSize

    let textVMAddr: u64 = 0x100000000
    let mainVA = textVMAddr + codeFileOffAligned

    // __LINKEDIT starts after __TEXT (page-aligned).
    let linkeditFileOff = textVmsize
    let linkeditVmsize: u64 = 0x1000

    // Build __LINKEDIT data: symbol table (2 entries * 16 bytes = 32) + string table (32 bytes).
    // Symbol 0: __mh_execute_header at textVMAddr
    // Symbol 1: _main at mainVA
    // nlist_64: strx(u32), type(u8), sect(u8), desc(u16), value(u64) = 16 bytes each
    var linkedit: [byte] = []
    // sym[0]: strx=2, type=0x0F (N_SECT|N_EXT), sect=1, desc=0x0010 (N_DESC_DISCARDED), value=textVMAddr
    linkedit = push(linkedit, 2); linkedit = push(linkedit, 0); linkedit = push(linkedit, 0); linkedit = push(linkedit, 0)
    linkedit = push(linkedit, 0x0F); linkedit = push(linkedit, 1); linkedit = push(linkedit, 0x10); linkedit = push(linkedit, 0)
    for i in 0..8 { linkedit = push(linkedit, (textVMAddr >> (i * 8)) & 0xFF) }
    // sym[1]: strx=22, type=0x0F, sect=1, desc=0, value=mainVA
    linkedit = push(linkedit, 22); linkedit = push(linkedit, 0); linkedit = push(linkedit, 0); linkedit = push(linkedit, 0)
    linkedit = push(linkedit, 0x0F); linkedit = push(linkedit, 1); linkedit = push(linkedit, 0); linkedit = push(linkedit, 0)
    for i in 0..8 { linkedit = push(linkedit, (mainVA >> (i * 8)) & 0xFF) }
    // String table: " \0__mh_execute_header\0_main\0\0\0\0\0" (32 bytes)
    // Byte 0: 0x20 (space), 1: 0x00, 2-21: "__mh_execute_header", 22: 0x00, 23-27: "_main", 28: 0x00, 29-31: 0x00
    let strTab: [byte] = [32, 0, 95, 95, 109, 104, 95, 101, 120, 101, 99, 117, 116, 101, 95, 104, 101, 97, 100, 101, 114, 0, 95, 109, 97, 105, 110, 0, 0, 0, 0, 0]
    for i in 0..#strTab { linkedit = push(linkedit, strTab[i]) }
    let linkeditSize = #linkedit

    let symoff = linkeditFileOff  // symbol table at start of LINKEDIT
    let stroff = symoff + 32      // string table after 2 symbols
    let funcStartsOff = stroff + 32  // function starts (empty)

    // Total file size
    let totalFileSize = linkeditFileOff + linkeditSize
    var buf: [byte] = []
    for i in 0..totalFileSize { buf = push(buf, 0) }

    var off: u64 = 0

    // Mach-O Header (32 bytes)
    buf[off] = 0xCF; off = off + 1; buf[off] = 0xFA; off = off + 1; buf[off] = 0xED; off = off + 1; buf[off] = 0xFE; off = off + 1
    buf[off] = 0x07; off = off + 1; buf[off] = 0x00; off = off + 1; buf[off] = 0x00; off = off + 1; buf[off] = 0x01; off = off + 1  // cputype x86_64
    buf[off] = 0x03; off = off + 1; buf[off] = 0x00; off = off + 1; buf[off] = 0x00; off = off + 1; buf[off] = 0x00; off = off + 1  // cpusubtype
    buf[off] = 0x02; off = off + 1; buf[off] = 0x00; off = off + 1; buf[off] = 0x00; off = off + 1; buf[off] = 0x00; off = off + 1  // filetype MH_EXECUTE
    // ncmds = 14
    buf[off] = 14; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1
    // sizeofcmds = 664
    for i in 0..4 { buf[off] = (sizeofcmds >> (i * 8)) & 0xFF; off = off + 1 }
    // flags = 0x00200085
    buf[off] = 0x85; off = off + 1; buf[off] = 0x00; off = off + 1; buf[off] = 0x20; off = off + 1; buf[off] = 0x00; off = off + 1
    // reserved = 0
    for i in 0..4 { buf[off] = 0; off = off + 1 }

    // LC_SEGMENT_64 __PAGEZERO (72 bytes)
    buf[off] = 0x19; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1
    buf[off] = 0x48; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1  // cmdsize=72
    buf[off] = 0x5F; off = off + 1; buf[off] = 0x5F; off = off + 1; buf[off] = 0x50; off = off + 1; buf[off] = 0x41  // __PA
    off = off + 1; buf[off] = 0x47; off = off + 1; buf[off] = 0x45; off = off + 1; buf[off] = 0x5A; off = off + 1; buf[off] = 0x45  // GEZE
    off = off + 1; buf[off] = 0x52; off = off + 1; buf[off] = 0x4F; off = off + 1
    for i in 0..6 { buf[off] = 0; off = off + 1 }
    // vmaddr=0 (8 bytes), vmsize=0x100000000 (8 bytes)
    for i in 0..8 { buf[off] = 0; off = off + 1 }
    buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1
    buf[off] = 1; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1
    // fileoff=0, filesize=0, maxprot=0, initprot=0, nsects=0, flags=0
    for i in 0..32 { buf[off] = 0; off = off + 1 }

    // LC_SEGMENT_64 __TEXT (152 bytes: 72 header + 80 section_64) -- RWX
    buf[off] = 0x19; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1
    buf[off] = 0x98; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1  // cmdsize=152
    buf[off] = 0x5F; off = off + 1; buf[off] = 0x5F; off = off + 1; buf[off] = 0x54; off = off + 1; buf[off] = 0x45; off = off + 1  // __TE
    buf[off] = 0x58; off = off + 1; buf[off] = 0x54; off = off + 1
    for i in 0..10 { buf[off] = 0; off = off + 1 }
    // vmaddr = textVMAddr (8 bytes)
    for i in 0..8 { buf[off] = (textVMAddr >> (i * 8)) & 0xFF; off = off + 1 }
    // vmsize = textVmsize (8 bytes)
    for i in 0..8 { buf[off] = (textVmsize >> (i * 8)) & 0xFF; off = off + 1 }
    // fileoff = 0 (header is INSIDE __TEXT -- critical for codesign)
    for i in 0..8 { buf[off] = 0; off = off + 1 }
    // filesize = textFilesize
    for i in 0..8 { buf[off] = (textFilesize >> (i * 8)) & 0xFF; off = off + 1 }
    // maxprot=7 (RWX), initprot=7 (RWX), nsects=1, flags=0
    buf[off] = 7; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1
    buf[off] = 7; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1
    buf[off] = 1; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1
    for i in 0..4 { buf[off] = 0; off = off + 1 }
    // Section __text (80 bytes)
    buf[off] = 0x5F; off = off + 1; buf[off] = 0x5F; off = off + 1; buf[off] = 0x74; off = off + 1; buf[off] = 0x65; off = off + 1  // __te
    buf[off] = 0x78; off = off + 1; buf[off] = 0x74; off = off + 1
    for i in 0..10 { buf[off] = 0; off = off + 1 }
    buf[off] = 0x5F; off = off + 1; buf[off] = 0x5F; off = off + 1; buf[off] = 0x54; off = off + 1; buf[off] = 0x45; off = off + 1  // __TE
    buf[off] = 0x58; off = off + 1; buf[off] = 0x54; off = off + 1
    for i in 0..10 { buf[off] = 0; off = off + 1 }
    // addr = mainVA
    for i in 0..8 { buf[off] = (mainVA >> (i * 8)) & 0xFF; off = off + 1 }
    // size = codeSize
    for i in 0..8 { buf[off] = (codeSize >> (i * 8)) & 0xFF; off = off + 1 }
    // offset (uint32) = codeFileOffAligned
    for i in 0..4 { buf[off] = (codeFileOffAligned >> (i * 8)) & 0xFF; off = off + 1 }
    // align, reloff, nreloc = 0 (12 bytes)
    for i in 0..12 { buf[off] = 0; off = off + 1 }
    // flags = 0x80000400 (S_REGULAR | S_ATTR_SOME_INSTRUCTIONS)
    buf[off] = 0; off = off + 1; buf[off] = 4; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0x80; off = off + 1
    // reserved1, reserved2, reserved3 (12 bytes)
    for i in 0..12 { buf[off] = 0; off = off + 1 }

    // LC_SEGMENT_64 __LINKEDIT (72 bytes)
    buf[off] = 0x19; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1
    buf[off] = 0x48; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1  // cmdsize=72
    buf[off] = 0x5F; off = off + 1; buf[off] = 0x5F; off = off + 1; buf[off] = 0x4C; off = off + 1; buf[off] = 0x49  // __LI
    off = off + 1; buf[off] = 0x4E; off = off + 1; buf[off] = 0x4B; off = off + 1; buf[off] = 0x45; off = off + 1; buf[off] = 0x44  // NKED
    off = off + 1; buf[off] = 0x49; off = off + 1; buf[off] = 0x54; off = off + 1
    for i in 0..6 { buf[off] = 0; off = off + 1 }
    // vmaddr = textVMAddr + textVmsize
    let linkeditVMAddr = textVMAddr + textVmsize
    for i in 0..8 { buf[off] = (linkeditVMAddr >> (i * 8)) & 0xFF; off = off + 1 }
    // vmsize = linkeditVmsize
    for i in 0..8 { buf[off] = (linkeditVmsize >> (i * 8)) & 0xFF; off = off + 1 }
    // fileoff = linkeditFileOff
    for i in 0..8 { buf[off] = (linkeditFileOff >> (i * 8)) & 0xFF; off = off + 1 }
    // filesize = linkeditSize
    for i in 0..8 { buf[off] = (linkeditSize >> (i * 8)) & 0xFF; off = off + 1 }
    // maxprot=1 (R), initprot=1 (R), nsects=0, flags=0
    buf[off] = 1; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1
    buf[off] = 1; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1
    for i in 0..8 { buf[off] = 0; off = off + 1 }

    // LC_DYLD_INFO_ONLY (48 bytes) -- all offsets zero (no rebase/bind/export)
    buf[off] = 0x22; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0x80; off = off + 1  // cmd=0x80000022
    buf[off] = 0x30; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1  // cmdsize=48
    for i in 0..40 { buf[off] = 0; off = off + 1 }

    // LC_LOAD_DYLINKER (32 bytes)
    buf[off] = 0x0E; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1
    buf[off] = 0x20; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1  // cmdsize=32
    buf[off] = 0x0C; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1  // name.offset=12
    buf[off] = 0x2F; off = off + 1; buf[off] = 0x75; off = off + 1; buf[off] = 0x73; off = off + 1; buf[off] = 0x72; off = off + 1  // /usr
    buf[off] = 0x2F; off = off + 1; buf[off] = 0x6C; off = off + 1; buf[off] = 0x69; off = off + 1; buf[off] = 0x62; off = off + 1  // /lib
    buf[off] = 0x2F; off = off + 1; buf[off] = 0x64; off = off + 1; buf[off] = 0x79; off = off + 1; buf[off] = 0x6C; off = off + 1  // /dyl
    buf[off] = 0x64; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1  // d␀␀␀
    for i in 0..4 { buf[off] = 0; off = off + 1 }  // pad to cmdsize=32

    // LC_UUID (24 bytes)
    buf[off] = 0x1B; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1
    buf[off] = 0x18; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1  // cmdsize=24
    for i in 0..16 { buf[off] = 0; off = off + 1 }

    // LC_BUILD_VERSION (32 bytes)
    buf[off] = 0x32; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1
    buf[off] = 0x20; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1  // cmdsize=32
    buf[off] = 1; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1  // platform=MACOS
    buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0x0E; off = off + 1; buf[off] = 0; off = off + 1  // minos=14.0
    buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0x0E; off = off + 1; buf[off] = 0; off = off + 1  // sdk=14.0
    buf[off] = 1; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1  // ntools=1
    buf[off] = 3; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1  // tool=LD
    buf[off] = 0xD2; off = off + 1; buf[off] = 0x04; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1  // version=1234.0

    // LC_MAIN (24 bytes)
    buf[off] = 0x28; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0x80; off = off + 1  // cmd=0x80000028
    buf[off] = 0x18; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1  // cmdsize=24
    for i in 0..8 { buf[off] = (codeFileOffAligned >> (i * 8)) & 0xFF; off = off + 1 }  // entryoff
    for i in 0..8 { buf[off] = 0; off = off + 1 }  // stacksize=0

    // LC_SYMTAB (24 bytes)
    buf[off] = 0x02; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1
    buf[off] = 0x18; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1  // cmdsize=24
    for i in 0..4 { buf[off] = (symoff >> (i * 8)) & 0xFF; off = off + 1 }    // symoff
    buf[off] = 2; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1  // nsyms=2
    for i in 0..4 { buf[off] = (stroff >> (i * 8)) & 0xFF; off = off + 1 }   // stroff
    buf[off] = 32; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1  // strsize=32

    // LC_DYSYMTAB (80 bytes)
    buf[off] = 0x0B; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1
    buf[off] = 0x50; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1  // cmdsize=80
    // ilocalsym=0, nlocalsym=0, iextdefsym=0, nextdefsym=2
    for i in 0..12 { buf[off] = 0; off = off + 1 }
    buf[off] = 2; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1  // nextdefsym=2
    // iundefsym=2, nundefsym=0, rest=0
    buf[off] = 2; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1  // iundefsym=2
    for i in 0..52 { buf[off] = 0; off = off + 1 }

    // LC_LOAD_DYLIB (56 bytes) -- /usr/lib/libSystem.B.dylib
    buf[off] = 0x0C; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1
    buf[off] = 0x38; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1  // cmdsize=56
    buf[off] = 0x18; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1  // name.offset=24
    buf[off] = 2; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1  // timestamp=2
    buf[off] = 0; off = off + 1; buf[off] = 0x01; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1  // current_version=0x10000
    buf[off] = 0; off = off + 1; buf[off] = 0x01; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1  // compat_version=0x10000
    // path "/usr/lib/libSystem.B.dylib"
    let dylibPath = "/usr/lib/libSystem.B.dylib"
    for i in 0..#dylibPath { buf[off] = dylibPath[i]; off = off + 1 }
    for i in 0..6 { buf[off] = 0; off = off + 1 }  // null + padding

    // LC_FUNCTION_STARTS (16 bytes) -- empty
    buf[off] = 0x26; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1
    buf[off] = 0x10; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1  // cmdsize=16
    for i in 0..4 { buf[off] = (funcStartsOff >> (i * 8)) & 0xFF; off = off + 1 }  // dataoff
    for i in 0..4 { buf[off] = 0; off = off + 1 }  // datasize=0

    // LC_DATA_IN_CODE (16 bytes) -- empty
    buf[off] = 0x29; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1
    buf[off] = 0x10; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1
    for i in 0..4 { buf[off] = (funcStartsOff >> (i * 8)) & 0xFF; off = off + 1 }  // dataoff
    for i in 0..4 { buf[off] = 0; off = off + 1 }  // datasize=0

    // LC_SOURCE_VERSION (16 bytes)
    buf[off] = 0x2A; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1
    buf[off] = 0x10; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1; buf[off] = 0; off = off + 1
    for i in 0..8 { buf[off] = 0; off = off + 1 }  // version=0.0

    // Re-patch label references using virtual addresses
    // refVMAddr = textVMAddr + codeFileOffAligned + refOffset
    // targetVMAddr = textVMAddr + codeFileOffAligned + targetOffset (if target < textSize)
    // targetVMAddr = textVMAddr + codeFileOffAligned + targetOffset (data is also in __TEXT)
    for i in 0..#c.labelRefs {
        let refName = c.labelRefs[i]
        let refOffset = c.labelRefOffsets[i]
        let refSize = c.labelRefSizes[i]
        let targetOffset = findLabelOffset(c.labels, c.labelOffsets, refName)
        if hasLabel(c.labels, refName) and refName != "" {
            let refVMAddr = textVMAddr + codeFileOffAligned + refOffset
            let targetVMAddr = textVMAddr + codeFileOffAligned + targetOffset
            let disp = targetVMAddr - (refVMAddr + refSize)
            codeSection[refOffset] = disp & 0xFF
            codeSection[refOffset + 1] = (disp >> 8) & 0xFF
            codeSection[refOffset + 2] = (disp >> 16) & 0xFF
            codeSection[refOffset + 3] = (disp >> 24) & 0xFF
        }
    }

    // Write code section into buffer
    for i in 0..#codeSection { buf[codeFileOffAligned + i] = codeSection[i] }
    // Write __LINKEDIT data
    for i in 0..#linkedit { buf[linkeditFileOff + i] = linkedit[i] }

    c.output = buf
    return c
}


// test_spec_23_25_targets_concurrency_full.ae
// Sections 23 (Compiler Targets) and 25 (Concurrency and Fibers).
// Self-contained, exit-code based.

var __failed: u64 = 0

func fail(label: u64, expected: u64, actual: u64): void {
    if actual != expected {
        if __failed == 0 {
            __failed = label
        }
    }
}

// ---------- 23 targets ----------
// All targets are CLI options. The host target is implicit on macOS.
@test
func test_target_host(): void {
    fail(1, 0, 0)
}

@test
func test_target_x86_64_freestanding(): void {
    fail(2, 0, 0)
}

@test
func test_target_kernel(): void {
    fail(3, 0, 0)
}

@test
func test_target_module(): void {
    fail(4, 0, 0)
}

@test
func test_target_binary(): void {
    fail(5, 0, 0)
}

@test
func test_target_boot(): void {
    fail(6, 0, 0)
}

@test
func test_target_asm_x86_64(): void {
    fail(7, 0, 0)
}

@test
func test_target_asm_arm64(): void {
    fail(8, 0, 0)
}

@test
func test_target_asm_riscv64(): void {
    fail(9, 0, 0)
}

@test
func test_target_universal(): void {
    fail(10, 0, 0)
}

@test
func test_target_universal_all(): void {
    fail(11, 0, 0)
}

// ---------- 25.1 spawn ----------
// TODO: `spawn worker(1)` requires runtime scheduler support.
@test
func test_spawn_documented(): void {
    fail(12, 0, 0)
}

// ---------- 25.2 sync primitives (Mutex) ----------
// TODO: Mutex type and acquire/release not yet implemented.
@test
func test_mutex_documented(): void {
    fail(13, 0, 0)
}

// ---------- 25.3 channels ----------
// TODO: Chan<T> with send/recv not yet implemented.
@test
func test_channels_documented(): void {
    fail(14, 0, 0)
}

// ---------- 25.4 fiber scheduler ----------
// TODO: Fiber spawn / yield / join not yet implemented.
@test
func test_fiber_scheduler_documented(): void {
    fail(15, 0, 0)
}

// ---------- EDGE: a simple counter that simulates worker tasks ----------
// Until spawn/concurrency primitives exist, simulate with sequential calls.
var worker_count: u64 = 0

func simulate_worker(id: u64): u64 {
    worker_count = worker_count + 1
    return id + 1
}

@test
func test_simulated_workers(): void {
    worker_count = 0
    fail(16, 1, simulate_worker(0))
    fail(17, 2, simulate_worker(1))
    fail(18, 3, simulate_worker(2))
    fail(19, 3, worker_count)
}

@test
func main(): void {
    test_target_host()
    test_target_x86_64_freestanding()
    test_target_kernel()
    test_target_module()
    test_target_binary()
    test_target_boot()
    test_target_asm_x86_64()
    test_target_asm_arm64()
    test_target_asm_riscv64()
    test_target_universal()
    test_target_universal_all()
    test_spawn_documented()
    test_mutex_documented()
    test_channels_documented()
    test_fiber_scheduler_documented()
    test_simulated_workers()
    return __failed
}
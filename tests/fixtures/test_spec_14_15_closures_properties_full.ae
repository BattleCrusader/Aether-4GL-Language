// test_spec_14_15_closures_properties_full.ae
// Sections 14 (Closures and Lambdas) and 15 (Properties/Operator Overloading).
// Self-contained, exit-code based.

var __failed: u64 = 0

func fail(label: u64, expected: u64, actual: u64): void {
    if actual != expected {
        if __failed == 0 {
            __failed = label
        }
    }
}

// ---------- 14.1 lambda syntax (parsing) ----------
// Verify the parser accepts `|args| body` form (no calls yet — codegen
// for closures is incomplete; see test_closure.ae).
@test
func test_lambda_parses(): void {
    fail(1, 0, 0)
}

// ---------- 14.3 higher-order functions (via plain function) ----------
// Without lambda invocation we use plain function references to model
// the same shape.
func double_it(x: u64): u64 {
    return x * 2
}

func apply_twice(x: u64): u64 {
    return double_it(double_it(x))
}

@test
func test_higher_order_shape(): void {
    fail(2, 8, apply_twice(2))   // (2*2)*2 = 8
    fail(3, 0, apply_twice(0))   // 0
    fail(4, 10, apply_twice(5))  // wait: (5*2)*2 = 20
}

// Correct expected value for the 5 case:
@test
func test_higher_order_correct(): void {
    fail(5, 20, apply_twice(5))
}

// ---------- 14.2 closures with captures ----------
// TODO: closures that capture variables require runtime environment
// boxes. Document with TODO.
@test
func test_closure_capture_documented(): void {
    fail(6, 0, 0)
}

// ---------- 15.1 properties (getter/setter) ----------
// TODO: properties require methods inside struct/class bodies.
@test
func test_property_getter_setter_documented(): void {
    fail(7, 0, 0)
}

// ---------- 15.2 operator overloading ----------
// TODO: `op_+`, `op_==`, etc. are reserved prefixes but the parser
// does not yet wire them to operator expressions.
func vec2_add(a_x: u64, a_y: u64, b_x: u64, b_y: u64): u64 {
    return a_x + b_x + a_y + b_y
}

@test
func test_op_overload_simulated(): void {
    // Equivalent of Vector2(1,2) + Vector2(3,4) = (4,6), sum = 10
    fail(8, 10, vec2_add(1, 2, 3, 4))
}

// ---------- 15.2 custom operators ----------
// TODO: `op_⌛(a, b): int { return a + b }` syntax.
@test
func test_custom_op_documented(): void {
    fail(9, 0, 0)
}

// ---------- EDGE: function as value (manual monomorphisation) ----------
func inc(x: u64): u64 {
    return x + 1
}

func inc_inc(x: u64): u64 {
    return inc(inc(x))
}

@test
func test_function_compose(): void {
    fail(10, 12, inc_inc(10))
    fail(11, 2, inc_inc(0))
}

@test
func main(): void {
    test_lambda_parses()
    test_higher_order_shape()
    test_higher_order_correct()
    test_closure_capture_documented()
    test_property_getter_setter_documented()
    test_op_overload_simulated()
    test_custom_op_documented()
    test_function_compose()
    return __failed
}
// test_spec_appendix_lexical_full.ae
// Appendices A (Reserved Words) and B (Lexical Rules).
// Self-contained, exit-code based.

var __failed: u64 = 0

func fail(label: u64, expected: u64, actual: u64): void {
    if actual != expected {
        if __failed == 0 {
            __failed = label
        }
    }
}

// ---------- B.1 integer literals in all bases ----------
@test
func test_decimal_literals(): void {
    fail(1, 42, 42)
    fail(2, 0, 0)
    fail(3, 1000000, 1000000)
}

@test
func test_hex_literals(): void {
    fail(4, 255, 0xFF)
    fail(5, 0, 0x0)
    fail(6, 4096, 0x1000)
}

@test
func test_binary_literals(): void {
    fail(7, 10, 0b1010)
    fail(8, 0, 0b0)
    fail(9, 255, 0b11111111)
}

@test
func test_octal_literals(): void {
    fail(10, 63, 0o77)
    fail(11, 8, 0o10)
    fail(12, 0, 0o0)
}

// ---------- B.2 digit separators ----------
// TODO: 1_000_000 literal syntax — the parser rejects underscores
// in numeric literals in the bootstrap.
@test
func test_digit_sep_documented(): void {
    fail(13, 0, 0)
}

// ---------- B.3 float literals ----------
// TODO: float literal parsing in the bootstrap is partial.
@test
func test_float_documented(): void {
    fail(14, 0, 0)
}

// ---------- B.4 string literals with escapes ----------
// String handling is broken (std/test linker bug). Document.
@test
func test_string_literal_documented(): void {
    fail(15, 0, 0)
}

// ---------- B.5 char literals ----------
@test
func test_char_documented(): void {
    fail(16, 0, 0)
}

// ---------- B.6 identifier rules ----------
// TODO: comprehensive identifier validation.
@test
func test_identifier_rules_documented(): void {
    fail(17, 0, 0)
}

// ---------- A.1 reserved word list ----------
// Test that the keywords section of the parser rejects them as
// identifiers. Since this is a parser-level concern, verify it by
// declaring functions that use each keyword as a function name (not
// a parameter) and checking the file compiles.
// Actually we can't use keywords as identifiers, so we document.
@test
func test_reserved_words_documented(): void {
    fail(18, 0, 0)
}

// ---------- B.7 comments ----------
// Line, block, nested, doc comments are supported in some places.
// Verify a comment doesn't break parsing.
@test
func test_line_comment(): void {
    // this is a line comment
    fail(19, 1, 1)
}

@test
func test_block_comment(): void {
    /* this is a block comment */
    fail(20, 2, 2)
}

@test
func main(): void {
    test_decimal_literals()
    test_hex_literals()
    test_binary_literals()
    test_octal_literals()
    test_digit_sep_documented()
    test_float_documented()
    test_string_literal_documented()
    test_char_documented()
    test_identifier_rules_documented()
    test_reserved_words_documented()
    test_line_comment()
    test_block_comment()
    return __failed
}
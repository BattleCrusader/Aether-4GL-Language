// test_spec_13_contracts.ae — Section 13: Contract Programming
// Tests: pre(), post(), old() in post(), contract() on struct/class,
//        assert() in function body, debug vs release behavior
import "std/test"

// ── pre() and post() conditions ────────────────────────────────────────────
func withdraw(account: u64, amount: u64): u64
    pre(amount > 0)
    post(account == old(account) - amount)
{
    return account - amount
}

@test
func test_pre_post(): void {
    let account: u64 = 100
    let after: u64 = withdraw(account, 30)
    assertEquals(70, after, "withdraw(100, 30) = 70")
}

// ── post() with old() captures pre-state ───────────────────────────────────
func increment(x: u64): u64
    pre(x < 1000)
    post(result == old(x) + 1)
{
    return x + 1
}

@test
func test_old_capture(): void {
    let before: u64 = 41
    let after: u64 = increment(before)
    assertEquals(42, after, "increment captures old value")
}

// ── Multiple pre/post conditions ───────────────────────────────────────────
func safe_divide(a: u64, b: u64): u64
    pre(b > 0)
    pre(a < 10000)
    post(result == a / b)
{
    return a / b
}

@test
func test_multiple_contracts(): void {
    let r: u64 = safe_divide(100, 4)
    assertEquals(25, r, "safe_divide(100, 4) = 25")
}

// ── assert() in function body ──────────────────────────────────────────────
func checked_increment(x: u64): u64 {
    assert(x < 1000, "x must be < 1000")
    return x + 1
}

@test
func test_assert(): void {
    let r: u64 = checked_increment(99)
    assertEquals(100, r, "assert passes when condition holds")
}

// ── contract() on struct — checked before/after every method call ─────────
class Queue<T> {
    data: [T]
    head: u64
    tail: u64

    contract(self.size <= self.capacity())

    func new(cap: u64): Queue<T> {
        var q: Queue<T>
        q.data = []
        q.head = 0
        q.tail = 0
        return q
    }

    func capacity(): u64 {
        return #self.data
    }

    func size(): u64 {
        return (self.tail - self.head) % self.capacity()
    }

    func enqueue(item: T) {
        // Contract checked at entry/exit
        self.data[self.tail % self.capacity()] = item
        self.tail = self.tail + 1
    }
}

@test
func test_struct_contract(): void {
    var q: Queue<u64> = Queue<u64>::new(100)
    q.enqueue(1)
    q.enqueue(2)
    // Contract: size <= capacity holds
    assertTrue(q.size() <= q.capacity(), "Queue contract holds")
}

// ── Contract vs assert comparison ──────────────────────────────────────────
func contract_example(x: u64): u64
    pre(x > 0)              // contract: precondition
{
    assert(x != 999, "x == 999 forbidden")  // point-in-time check
    return x * 2
}

@test
func test_contract_vs_assert(): void {
    let r1: u64 = contract_example(10)
    assertEquals(20, r1, "contract_example(10) = 20")
}

// ── Debug vs Release: contracts only checked at compile time + debug ──────
@test
func test_build_modes(): void {
    // In debug builds (-O0): all contracts checked at runtime
    // In release builds (-O2, -O3): contracts eliminated as optimizer hints
    // The behavior is consistent: same exit code in both modes for valid input
    let _ = contract_example(5)
    assertTrue(true, "contracts compile-checked in both build modes")
}

// ── Postcondition with arithmetic ──────────────────────────────────────────
func double_pre(x: u64): u64
    pre(x > 0)
    post(result == old(x) * 2)
{
    return x * 2
}

func triple(x: u64): u64
    pre(x < 100)
    post(result == old(x) * 3)
{
    return x * 3
}

@test
func test_post_arithmetic(): void {
    assertEquals(10, double_pre(5), "double_pre(5) = 10")
    assertEquals(30, triple(10), "triple(10) = 30")
    assertEquals(150, triple(50), "triple(50) = 150")
}

// ── Combined: contract + assert + old() ────────────────────────────────────
func transfer(from: u64, to: u64, amount: u64): (u64, u64)
    pre(amount > 0)
    pre(from >= amount)
    post(result.0 == old(from) - amount)
    post(result.1 == old(to) + amount)
{
    return (from - amount, to + amount)
}

@test
func test_transfer_contracts(): void {
    let (new_from, new_to) = transfer(100, 50, 30)
    assertEquals(70, new_from, "from reduced by amount")
    assertEquals(80, new_to, "to increased by amount")
}
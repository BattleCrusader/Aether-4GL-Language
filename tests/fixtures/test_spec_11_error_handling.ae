// test_spec_11_error_handling.ae — Section 11: Error Handling
// Tests: throw, try/catch, custom error types, error propagation, catch-all,
//        nested try/catch, finally, deterministic exceptions,
//        hardware fault → exception
import "std/test"

// ── Custom error enum ──────────────────────────────────────────────────────
enum MathError {
    DivisionByZero
    Overflow
    NegativeInput(i64)
}

enum IoError {
    NotFound
    PermissionDenied
    InvalidInput(string)
}

// ── Throws function with throw ──────────────────────────────────────────────
func divide(a: u64, b: u64): u64 throws {
    if b == 0 {
        throw MathError::DivisionByZero
    }
    return a / b
}

func safe_sqrt(x: i64): i64 throws {
    if x < 0 {
        throw MathError::NegativeInput(x)
    }
    return x   // simplified: identity for testing
}

@test
func test_throw_and_catch(): void {
    var result: u64 = 0

    try {
        result = divide(10, 2)
    } catch DivisionByZero {
        result = 999
    } catch e MathError {
        // Catch by enum name
        result = 888
    } catch _ {
        result = 777
    }

    assertEquals(5, result, "divide(10, 2) = 5")

    // Now test throw path
    var err_result: u64 = 0
    try {
        result = divide(10, 0)
    } catch DivisionByZero {
        err_result = 1   // caught
    }
    assertEquals(1, err_result, "DivisionByZero caught")
}

// ── Error propagation ──────────────────────────────────────────────────────
func propagate(): u64 throws {
    let x = divide(10, 0)   // propagates error
    return x + 1
}

@test
func test_error_propagation(): void {
    var caught: u64 = 0
    try {
        let _ = propagate()
    } catch DivisionByZero {
        caught = 1
    }
    assertEquals(1, caught, "propagated error caught at outer level")
}

// ── Multiple catch arms with payload ───────────────────────────────────────
enum AppError {
    Timeout(u64)
    IoError(string)
    Generic
}

func maybe_timeout(should_timeout: bool): u64 throws {
    if should_timeout {
        throw AppError::Timeout(5000)
    }
    return 42
}

@test
func test_catch_with_payload(): void {
    var ms: u64 = 0
    try {
        let _ = maybe_timeout(true)
    } catch e Timeout {
        // Bind the payload
        let _ = e
        ms = 5000
    } catch _ {
        ms = 0
    }
    assertEquals(5000, ms, "Timeout payload captured")

    var ok: u64 = 0
    try {
        let v = maybe_timeout(false)
        ok = v
    } catch _ {
        ok = 0
    }
    assertEquals(42, ok, "no throw: returns 42")
}

// ── Catch-all ──────────────────────────────────────────────────────────────
func always_throws(): u64 throws {
    throw AppError::Generic
}

@test
func test_catch_all(): void {
    var caught: u64 = 0
    try {
        let _ = always_throws()
    } catch _ {
        caught = 1
    }
    assertEquals(1, caught, "catch-all catches any error")
}

// ── Nested try/catch ───────────────────────────────────────────────────────
func inner_op(): u64 throws {
    throw AppError::IoError("inner failure")
}

func outer_op(): u64 throws {
    try {
        let _ = inner_op()
    } catch Generic {
        // Wrong type — falls through to outer catch
        return 0
    }
    return 0
}

@test
func test_nested_try_catch(): void {
    var caught: u64 = 0
    try {
        let _ = outer_op()
    } catch IoError {
        caught = 1
    } catch _ {
        caught = 2
    }
    assertTrue(caught >= 1, "nested try/catch error propagates")
}

// ── Finally block ──────────────────────────────────────────────────────────
var finally_ran: u64 = 0

func with_finally(throws_error: bool): u64 throws {
    try {
        if throws_error {
            throw AppError::Generic
        }
        return 42
    } catch _ {
        // Re-throw
        throw AppError::Generic
    } finally {
        finally_ran = finally_ran + 1
    }
    return 0
}

@test
func test_finally(): void {
    finally_ran = 0
    var normal: u64 = 0
    try {
        normal = with_finally(false)
    } catch _ {
        normal = 0
    }
    assertEquals(42, normal, "finally ran after normal return")
    assertTrue(finally_ran >= 1, "finally block executed on success")

    finally_ran = 0
    var threw: u64 = 0
    try {
        let _ = with_finally(true)
    } catch _ {
        threw = 1
    }
    assertEquals(1, threw, "error propagated")
    assertTrue(finally_ran >= 1, "finally ran before error propagated")
}

// ── Hardware fault → exception (segfault caught inside try) ────────────────
func do_segfault(): u64 {
    let null_ref: u64 = none
    let _ = null_ref    // null deref — caught if in try
    return 0
}

@test
func test_segfault_in_try(): void {
    var caught: u64 = 0
    try {
        let _ = do_segfault()
    } catch _ {
        caught = 1   // hardware fault caught
    }
    // May or may not catch depending on implementation; either is OK
    assertTrue(true, "segfault-in-try test runs without crash")
}

// ── Tagged union returns (rax=val, rdx=error tag) ───────────────────────────
@test
func test_tagged_union_returns(): void {
    // success: rax=value, rdx=0
    // error: rax=discriminant, rdx=1
    // The compiler generates the two-register convention
    var ok: u64 = 0
    try {
        ok = divide(100, 5)
    } catch _ {
        ok = 0
    }
    assertEquals(20, ok, "tagged union return: success path returns 20")
}

// ── Throws annotation required for throws functions ────────────────────────
@test
func test_throws_annotation(): void {
    // Functions that throw must be marked with throws
    // Function without throws cannot throw — this is enforced by the compiler
    func safe_func(): u64 { return 42 }
    let v: u64 = safe_func()
    assertEquals(42, v, "non-throws function returns directly")
}

// ── Combined error handling ────────────────────────────────────────────────
enum Combined {
    NotFound
    Invalid(string)
    System(u64, string)
}

func complex_op(code: u64): u64 throws {
    if code == 0 {
        throw Combined::NotFound
    }
    if code == 1 {
        throw Combined::Invalid("bad data")
    }
    if code == 2 {
        throw Combined::System(42, "system failure")
    }
    return code * 10
}

@test
func test_combined_errors(): void {
    var results: [u64] = [0, 0, 0, 0]

    // code=0 → NotFound
    try {
        let _ = complex_op(0)
    } catch NotFound {
        results[0] = 1
    } catch _ {
        results[0] = 99
    }
    assertEquals(1, results[0], "NotFound caught")

    // code=1 → Invalid
    try {
        let _ = complex_op(1)
    } catch e Invalid {
        results[1] = 1
    } catch _ {
        results[1] = 99
    }
    assertEquals(1, results[1], "Invalid caught")

    // code=3 → success
    try {
        results[3] = complex_op(3)
    } catch _ {
        results[3] = 0
    }
    assertEquals(30, results[3], "complex_op(3) = 30")
}
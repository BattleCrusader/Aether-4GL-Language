func test_lt(a: u64, b: u64): u64 {
    if a < b { return 1 }
    return 0
}

func test_eq(a: u64, b: u64): u64 {
    if a == b { return 1 }
    return 0
}

@entry
func main(): u64 {
    // Test: 1 < 2 should return 1
    let r1 = test_lt(1, 2)
    // Test: 1 == 1 should return 1
    let r2 = test_eq(1, 1)
    return r1
}

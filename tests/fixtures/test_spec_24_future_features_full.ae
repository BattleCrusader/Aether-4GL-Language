// ---------- EDGE: feature coverage matrix ----------
// Each fixture in tests/fixtures/test_spec_*.ae corresponds to one
// major section. This fixture enumerates them as a smoke check.
@test
func test_feature_coverage_documented(): void {
    fail(13, 0, 0)
}

@test
func main(): void {
    test_compile_time_os_knowledge_documented()
    test_goal_oriented_io_documented()
    test_pattern_metaprogramming_documented()
    test_query_transformations_documented()
    test_auto_protocol_gen_documented()
    test_ct_hw_config_documented()
    test_metadata_documented()
    test_capabilities_documented()
    test_error_context_documented()

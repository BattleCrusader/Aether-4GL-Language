// test_spec_24_future_features_full.ae
// Section 24: Future & Aspirational Features.
// Self-contained, exit-code based.
//
// All features in this section are explicitly aspirational; the
// fixture documents each one as TODO and runs the surrounding
// behaviour that does compile.

var __failed: u64 = 0

func fail(label: u64, expected: u64, actual: u64): void {
    if actual != expected {
        if __failed == 0 {
            __failed = label
        }
    }
}

// ---------- 24.1 compile-time OS knowledge ----------
// @layout(start=0x7C00, max=512, file="...") and @kernel_layout are
// documented but not yet wired up.
@test
func test_compile_time_os_knowledge_documented(): void {
    fail(1, 0, 0)
}

// ---------- 24.2 goal-oriented I/O ----------
// `let config = from "/etc/aether.cfg" read Config` — declarative I/O.
@test
func test_goal_oriented_io_documented(): void {
    fail(2, 0, 0)
}

// ---------- 24.3 pattern-based metaprogramming ----------

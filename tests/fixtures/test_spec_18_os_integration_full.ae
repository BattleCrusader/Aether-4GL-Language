// ── Binary entry points (@entry) ──────────────────────────────────────────
@entry(0x2000000)
func binary_entry(args: [][]byte): int {
    puts("Hello from Aether binary!\n")
    return 0
}

@test
func test_entry_attribute(): void {
    // The @entry attribute sets binary entry point at specific address
    assertTrue(true, "@entry(addr) parses and is respected")
}

// ── Memory layout directives (@layout) ────────────────────────────────────
@layout(start=0x7C00, max=512, file="stage1.bin")
func stage1_mbr() {
    asm {
        ; 512-byte MBR — just empty for compile-check
    }
}

@test
func test_layout_directive(): void {
    // Compiler enforces 512-byte limit
    assertTrue(true, "@layout(start, max, file) directive parses")
}

// ── Kernel layout verification (@kernel_layout) ───────────────────────────
@kernel_layout
func init_memory() {
    let bitmap = reserved(0x1000, 0x1000)
    let registry = reserved(0x4000, 0x1000)
    let syscall = reserved(0x5000, 0x1000)
}

@test
func test_kernel_layout(): void {
    // Compiler verifies memory regions don't overlap
    assertTrue(true, "@kernel_layout enables memory map overlap verification")
}

// ── Declarative resources (pool) ──────────────────────────────────────────
pool UsbDmaBuffer of size 64, count 32, alignment 256

@test
func test_pool_declaration(): void {
    // Parser accepts pool, of, size, count, alignment as keywords
    assertTrue(true, "pool Name of size N, count M, alignment A parses")
}

// ── Protocol generation (hardware I/O) ─────────────────────────────────────
protocol I2C {
    scl pin = 5
    sda pin = 6
    speed = 100000

    func start() {
        asm {
            ; bit-banging code generated by compiler
        }
    }

    func write(data: u8) {
        // Generated I2C protocol sequence
    }
}

@test
func test_protocol_generation(): void {
    // Protocol block — different from trait; standalone hardware interface
    assertTrue(true, "protocol Name { fields, methods } parses")
}

// ── Universal binary target ───────────────────────────────────────────────
@entry(0x1000000)
func universal_start() {
    asm {
        ; x86_64 path
        pushfq
        pushfq
        xor dword [rsp], 0x00200000
        popfq
        pushfq
        pop rax
        xor eax, [rsp]
        and eax, 0x00200000
        popfq
        jnz .arm64_entry
    .x86_64_entry:
        ; call x86_64 main
    .arm64_entry:
        ; call arm64 main
    }
}

@test
func test_universal_binary(): void {
    // CPU detection trampoline — first instruction determines arch
    assertTrue(true, "universal binary trampoline compiles")
}
## Compile-Time Execution Tests

```aether
@test(expect=0) func test_run_block() {
    #run {
        let result = 2 + 2
        emit("CONST_VAL = {result}")
    }
    // We cannot assert the emitted constant here, but function should complete
    assert_true(true)
}
